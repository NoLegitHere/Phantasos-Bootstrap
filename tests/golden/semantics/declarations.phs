type Missing
init {}
deinit {}
fun duplicate<T, T>(x: Int, x: Int) {
    let value = 1
    let value = 2
}
interface I { type Element; struct Nested { type Missing } }
class C { deinit {}; deinit {} }
enum E { Case(value: Int, value: Int), Case }
class Promoted(let x: Int) { let x: Int = 1 }
struct Implicit(x: Int) { let x: Int = 1 }

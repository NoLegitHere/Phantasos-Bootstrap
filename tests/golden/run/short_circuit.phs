// && and || skip their right operand when the left decides, so the
// division by zero never runs.

fun zero(): Int = 0

fun boom(): Bool = 1 / zero() == 1

fun main(): Int {
    var result = 0
    if false && boom() { result += 1 }
    if true || boom() { result += 2 }
    if !(false && boom()) { result += 4 }
    return result   // 6
}

// Expressions and statements outside the subset.

fun text(): Int {
    let s = "hi"
    return if s == "hi" { 1 } else { 0 }
}

fun loops(n: Int): Int {
    var total = 0
    total += n
    defer { total = 0 }
    return total
}

fun matching(x: Int): Int = match x {
    0 -> 1
    _ -> 2
}

fun values(): Int {
    let same: Bool = values == values
    return 0
}

fun inferred(c: Bool): Int {
    let v = if c { 1 } else { 2 }
    return v + 1
}

fun blocks(): Int {
    return unsafe { 0 }
}

fun main(): Int = 0

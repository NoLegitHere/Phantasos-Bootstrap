type Values<T> = [T]
type Rows<T> = Values<Values<T>>
class Box<T>(let value: T) {
    fun get(): T = value
    fun select<U>(value: U): U = value
}
type Wrapped<T> = Box<Values<T>>
fun identity<T>(value: T): T = value
let bytes: Rows<Int8> = [[1, 2], []]
let box = Box<Int8>(1)
let field: Int8 = box.value
let result: Int8 = box.get()
let selected: Bool = box.select<Bool>(true)
let wrapped: Wrapped<Int> = Wrapped<Int>([1])
let applied: Bool = identity<Bool>(true)
fun bounded<T: Copy>(value: T): T = value
let pending = bounded<Int>(1)

class Namespace { class Item<T>(let value: T) {} }
type Names = Namespace
let qualified: Names.Item<Int> = Namespace.Item<Int>(1)
class Types<T> { type Value = T }
let converted: Int8 = Types<Int8>.Value(1)
extern "C" { fun pendingIdentity<T>(marker: inout Bool): Int }
fun pendingDefault<T>(value: Int = pendingIdentity<T>(true)): Int = value
let omitted: Bool = pendingDefault<Int>()
class PendingDefault<T>(value: Int = pendingIdentity<T>(true)) {}
let omittedConstructor: Bool = PendingDefault<Int>()
class Inout<T>(value: inout T) {}
let pendingConvention: Bool = Inout<Int>(1)

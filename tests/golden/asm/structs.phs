// Narrow fields are stored at their size and loaded back sign- or
// zero-extended. A two-word struct returns in rax:rdx; a larger one is passed
// by address and returned through the hidden pointer in rdi.

struct Flags(on: Bool, level: Int8, mask: UInt16)
struct Point(x: Int, y: Int)
struct Box(min: Point, max: Point)

fun level(f: Flags): Int = Int(f.level) + Int(f.mask)

fun corner(b: Box): Point = b.max

fun widen(b: Box): Box = Box(min: b.max, max: b.min)

fun main(): Int {
    let b = widen(Box(min: Point(x: 1, y: 2), max: Point(x: 3, y: 4)))
    return corner(b).y + level(Flags(on: true, level: -2, mask: 3))
}

File
  Import std.io
  Import geometry.shapes as shapes
  Interface Shape vis=public mods=sealed
    Fun area
      Returns Float64
  Class Circle vis=public
    Ctor
      Param let radius: Float64
    Super Shape
    PrimaryInit
      Block
        Call
          Name require
          Binary Ge
            Name radius
            Float 0.0
    Deinit
      Block
        Call
          Member .println
            Name io
          String "circle freed"
    Fun area mods=override
      Returns Float64
      ExprBody
        Binary Mul
          Binary Mul
            Member .pi
              Name Float64
            Name radius
          Name radius
  Class Animal vis=public mods=open
    Ctor
      Param let name: String
    Fun speak vis=public mods=open
      Returns String
      ExprBody
        String "..."
  Class Dog vis=public
    Ctor
      Param name: String
    Super Animal()
      Name name
    Fun speak mods=override
      Returns String
      ExprBody
        String "Woof"
  Struct Point vis=public
    Ctor
      Param x: Int32
      Param y: Int32
  Enum ParseError vis=public
    Case Empty
    Case BadDigit(at: Int)
  Fun parse
    Param s: borrow String
    Returns Int
    Throws ParseError
    Body
      Block
        If
          Cond
            Member .isEmpty
              Name s
          Block
            Throw
              Member .Empty
                Name ParseError
        Var value
          Int 0
        For c
          Member .chars
            Name s
          Block
            If
              Cond
                Binary Or
                  Binary Lt
                    Name c
                    Char U+0030
                  Binary Gt
                    Name c
                    Char U+0039
              Block
                Throw
                  Call
                    ImplicitMember .BadDigit
                    Label at
                      Name value
            Assign =
              Name value
              Binary Add
                Binary Mul
                  Name value
                  Int 10
                Call
                  Name Int
                  Binary Sub
                    Member .value
                      Name c
                    Member .value
                      Char U+0030
        Return
          Name value
  Actor Counter
    Var value
      Int 0
    Fun increment mods=mut
      Body
        Block
          Assign +=
            Name value
            Int 1
  Fun main mods=async
    Throws ParseError
    Body
      Block
        Let c
          Call
            Name Circle
            Float 2.0
        Let s: shared Shape
          Unary Share
            Call
              Name Circle
              Float 1.0
        Let n
          Unary Try
            Call
              Name parse
              String "42"
        Let counter
          Call
            Name Counter
        Unary Await
          Call
            Member .increment
              Name counter
        Match
          Name s
          Arm is Circle as ci
            Call
              Member .println
                Name io
              Interp
                Text "radius "
                Member .radius
                  Name ci
                Text ""
          Arm _
            Block

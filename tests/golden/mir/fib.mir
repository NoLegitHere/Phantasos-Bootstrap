fun @fib(%0: i64) -> i64 {
bb0:
    %1: i64 = const 2
    %2: bool = lt %0, %1
    condbr %2, bb1, bb2
bb1:
    ret %0
bb2:
    %3: i64 = const 1
    %4: i64 = sub %0, %3
    %5: i64 = call @fib(%4)
    %6: i64 = const 2
    %7: i64 = sub %0, %6
    %8: i64 = call @fib(%7)
    %9: i64 = add %5, %8
    ret %9
}

fun @sumTo(%0: i64) -> i64 {
bb0:
    %1: i64 = const 0
    %2: i64 = copy %1
    %3: i64 = const 1
    %4: i64 = copy %3
    br bb1
bb1:
    %5: bool = le %4, %0
    condbr %5, bb2, bb7
bb2:
    %6: i64 = const 3
    %7: i64 = rem %4, %6
    %8: i64 = const 0
    %9: bool = eq %7, %8
    %10: bool = copy %9
    condbr %9, bb3, bb6
bb3:
    condbr %10, bb4, bb5
bb4:
    %2: i64 = add %2, %4
    br bb5
bb5:
    %15: i64 = const 1
    %4: i64 = add %4, %15
    br bb1
bb6:
    %11: i64 = const 5
    %12: i64 = rem %4, %11
    %13: i64 = const 0
    %14: bool = eq %12, %13
    %10: bool = copy %14
    br bb3
bb7:
    ret %2
}

fun @main() -> i64 entry {
bb0:
    %0: i64 = const 10
    %1: i64 = call @fib(%0)
    %2: i64 = const 9
    %3: i64 = call @sumTo(%2)
    %4: i64 = sub %1, %3
    %5: i64 = const 10
    %6: i64 = add %4, %5
    ret %6
}

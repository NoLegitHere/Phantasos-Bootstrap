struct @Point { x: i64 +0, y: i64 +8 } size 16 align 8

tuple @(Bool, Point, Int8) { 0: bool +16, 1: @Point +0, 2: i8 +17 } size 24 align 8

fun @split(%0: @(Bool, Point, Int8)) -> i64 {
bb0:
    %1: bool = field %0, 0
    %2: @Point = field %0, 1
    %3: i8 = field %0, 2
    condbr %1, bb1, bb3
bb1:
    %5: i64 = field %2, x
    %6: i64 = widen %3
    %7: i64 = add %5, %6
    %4: i64 = copy %7
    br bb2
bb2:
    ret %4
bb3:
    %8: @Point = field %0, 1
    %9: i64 = field %8, y
    %4: i64 = copy %9
    br bb2
}

fun @main() -> i64 entry {
bb0:
    %0: bool = const true
    %1: i64 = const 1
    %2: i64 = const 2
    %3: @Point = make %1, %2
    %4: i8 = const 3
    %5: @(Bool, Point, Int8) = make %0, %3, %4
    %6: @(Bool, Point, Int8) = copy %5
    %7: i64 = const 4
    %8: @Point = field %6, 1
    %8: @Point = with %8, x, %7
    %6: @(Bool, Point, Int8) = with %6, 1, %8
    %9: i64 = call @split(%6)
    ret %9
}

struct @Square { side: i64 +0 } size 8 align 8

fun @Square.area(%0: @Square) -> i64 {
bb0:
    %1: i64 = field %0, side
    %2: i64 = field %0, side
    %3: i64 = mul %1, %2
    ret %3
}

fun @main() -> i64 entry {
bb0:
    %0: i64 = const 3
    %1: @Square = make %0
    %2: i64 = call @measure<Square>(%1)
    ret %2
}

fun @measure<Square>(%0: @Square) -> i64 {
bb0:
    %1: i64 = call @Square.area(%0)
    %2: i64 = call @Shape.twice<Square>(%0)
    %3: i64 = add %1, %2
    ret %3
}

fun @Shape.twice<Square>(%0: @Square) -> i64 {
bb0:
    %1: i64 = call @Square.area(%0)
    %2: i64 = const 2
    %3: i64 = mul %1, %2
    ret %3
}

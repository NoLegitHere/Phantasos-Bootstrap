// Generic functions as values: an instance picked by the expected function
// type or by explicit type arguments, generic functions passed to generic
// functions, closures whose parameter types come from the other arguments
// of a generic call or whose results infer a type argument, and closures
// that own a generic value. The expected type picks among generic
// overloads with explicit type arguments.

struct Pair<A, B>(first: A, second: B)

fun identity<T>(x: T): T = x

fun apply<T>(f: fun(T) -> T, x: T): T = f(x)

fun map<T, U>(x: T, f: fun(T) -> U): U = f(x)

fun both<A, B>(p: Pair<A, A>, f: fun(A) -> B): Pair<B, B> = Pair(f(p.first), f(p.second))

fun compose<A, B, C>(f: fun(A) -> B, g: fun(B) -> C): fun(A) -> C = { a -> g(f(a)) }

fun keep<T>(x: own T): fun() -> T = { -> x }

fun pick<T>(x: T): T = x

fun pick<T>(x: T, y: T): T = y

fun main(): Int {
    let f: fun(Int) -> Int = identity
    let g = identity<String>
    print(f(1))
    print(g("explicit"))
    print(apply(identity, 2))
    print(apply({ s -> s + 1 }, 3))
    print(map(20, { x -> x > 10 }))
    print(map(3, { x -> map(x, { y -> y * 7 }) }))
    let p = both(Pair(1, 2), { v -> (v, v * v) })
    print(p.first.1 + p.second.1)
    let h = compose({ a: Int -> a + 1 }, { b -> b * 2 })
    print(h(4))
    let k = keep("kept")
    print(k())
    let one: fun(Int) -> Int = pick<Int>
    let two: fun(Int, Int) -> Int = pick<Int>
    print(one(5) + two(6, 7))
    return h(0)
}

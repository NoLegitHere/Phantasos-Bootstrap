// Arrays that grow and shrink, and `for` loops over arrays and ranges.

struct Task(let title: String, var done: Bool)

struct List(var tasks: [Task]) {
    mut fun add(title: own String) { tasks.append(Task(title, false)) }
    mut fun finish(i: Int) { tasks[i].done = true }
}

fun main(): Int {
    var squares: [Int] = []
    for i in 1..10 { squares.append(i * i) }
    var sum = 0
    for s in squares { sum += s }
    print(sum)

    while let last = squares.removeLast() {
        if last < 50 { break }
        print(last)
    }
    print(squares.count)

    var list = List([])
    list.add("write")
    list.add("test")
    list.add("ship")
    list.finish(1)
    for task in list.tasks {
        if task.done { continue }
        print(task.title)
    }

    var rows: [[Int]] = []
    for r in 0..<3 {
        rows.append([])
        for c in 0..<r + 1 { rows[r].append(c) }
    }
    print(rows[2].count)

    let top: UInt8 = 255
    var count = 0
    for b in UInt8(250)..top { count += 1 }
    print(count)

    var empty: [Int] = []
    print(empty.removeLast() ?? -1)
    return 0
}

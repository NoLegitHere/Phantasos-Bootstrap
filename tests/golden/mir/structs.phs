// Struct layouts come first. Constructors make an aggregate with its fields
// in declaration order, after evaluating arguments in source order.

struct Flags(on: Bool, level: Int8, mask: UInt32)
struct Point(x: Int, y: Int)
struct Label(text: String, at: Point)

fun origin(): Point = Point(y: 0, x: 0)

fun width(l: Label): Int = l.at.x

fun main(): Int {
    let f = Flags(mask: 255, level: -1, on: true)
    let l = Label(text: "here", at: origin())
    if f.on { print(l.text) }
    return width(l) + Int(f.level)
}

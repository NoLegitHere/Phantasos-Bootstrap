let forward = small
let small: Int8 = -128
let large: UInt64 = 18446744073709551615
let native = -9223372036854775808
let fraction: Float32 = (1.0 + 2.0) / 3.0
let contextual = 1 + small
let text = "hello"
let character = 'a'
let unit = ()
fun scalar(x: Int8 = 1): Int8 {
    var result = x
    result += 1
    if result < 10 && !false { result = 2 }
    while true { break }
    return result
}
fun floating(): Float32 = 1.0
fun unitReturn() { return }
type Wide = UInt64
let wideAlias: Wide = 18446744073709551615
let wideArray: [UInt64] = [18446744073709551615]
let wideBranch: UInt64 = if true { 18446744073709551615 } else { 0 }
let wideCall = takesWide(18446744073709551615)
fun takesWide(value: UInt64): UInt64 = value
fun discardedLiterals() { 1; 1.0; (2 + 3) }
let contextualTail: UInt64 = if true { 1; 18446744073709551615 } else { 0 }
fun discardedCall() { takesWide(18446744073709551615) }
struct ScalarStruct(value: Int8) { fun read(): Int8 = value }
class ScalarClass(let value: Int16) { fun read(): Int16 = value }
actor ScalarActor(var value: Float32) { fun read(): Float32 = value }
fun opaqueNumber(): Int = 1
let deferredArithmetic = 1 + opaqueNumber()
let deferredBits = opaqueNumber() & 1

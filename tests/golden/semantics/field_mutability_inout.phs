// An 'inout' argument must be a mutable place.

struct Slot(var a: Int, let b: Int)
fun bump(x: inout Int) { x += 1 }
fun swap(s: inout Slot) {}
fun pass(n: Int, slot: Slot) {
    bump(x: n)
    bump(x: slot.a)
    let s = Slot(1, 2)
    swap(s: s)
    bump(x: s.a)
    var t = Slot(1, 2)
    bump(x: t.b)
    bump(x: 3)
    swap(s: Slot(1, 2))
}
fun fine(x: inout Int) {
    var t = Slot(1, 2)
    bump(x: t.a)
    swap(s: t)
    bump(x: x)
    var n = 0
    bump(x: n)
}
struct Counter(n: Int) {
    fun add(x: inout Int) { x += n }
}
fun methods(c: Counter) {
    let a = 1
    c.add(x: a)
    var b = 1
    c.add(x: b)
}

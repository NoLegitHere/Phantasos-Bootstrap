struct @Point { x: i64 +0, y: i64 +8 } size 16 align 8

struct @Line { from: @Point +0, to: @Point +16 } size 32 align 8

fun @main() -> i64 entry {
bb0:
    %0: i64 = const 0
    %1: i64 = const 0
    %2: @Point = make %0, %1
    %3: i64 = const 1
    %4: i64 = const 1
    %5: @Point = make %3, %4
    %6: @Line = make %2, %5
    %7: @Line = copy %6
    %8: i64 = const 5
    %9: @Point = field %7, to
    %9: @Point = with %9, y, %8
    %7: @Line = with %7, to, %9
    %10: @Point = field %7, from
    %11: i64 = field %10, x
    %12: i64 = const 2
    %13: i64 = add %11, %12
    %14: @Point = field %7, from
    %14: @Point = with %14, x, %13
    %7: @Line = with %7, from, %14
    %15: i64 = const 3
    %16: i64 = const 4
    %17: @Point = make %15, %16
    %7: @Line = with %7, from, %17
    %18: @Point = field %7, to
    %19: i64 = field %18, y
    %20: @Point = field %7, from
    %21: i64 = field %20, x
    %22: i64 = sub %19, %21
    ret %22
}

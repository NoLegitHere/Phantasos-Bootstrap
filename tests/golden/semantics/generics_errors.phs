type Values<T> = [T]
class Box<T>(let value: T) { fun get(): T = value }
fun identity<T>(value: T): T = value
let wrongType: Box<Int> = Box<Bool>(true)
let wrongResult: Bool = Box<Int>(1).get()
let wrongCount: Values<Int, Bool>
let wrongCallCount = identity<Int, Bool>(1)
let wrongArgument = identity<Int>(true)
let outOfRange = identity<Int8>(128)
type Cycle<T> = Cycle<[T]>
let cyclic: Cycle<Int>

class Namespace { class Item<T>(let value: T) {} }
type Names = Namespace
let mismatched: Names.Item<Int> = Namespace.Item<Bool>(true)
let wrongQualifiedCount: Names.Item<Int, Bool>
class Types<T> { type Value = T }
let wrongAliasResult: Bool = Types<Int>.Value(1)

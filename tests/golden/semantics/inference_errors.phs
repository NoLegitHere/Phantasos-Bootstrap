interface Read { fun read(): Int }
class Missing {}
class Box<T: Read> {}
fun bounded<T: Read>(value: T): T = value
fun constrained<T>(value: T): T where T: Read = value
fun identity<T>(value: T): T = value
fun same<T>(first: T, second: T): T = first
let badBound = bounded(Missing())
let badWhere = constrained<Missing>(Missing())
let badAnnotation: Box<Int>
let badResult: Bool = identity(1)
let byte: Int8 = 1
let badRange = same(128, byte)
let conflicting = same(byte, false)

open class Parent {}
class Child: Parent {}
let child: Child?
let parent: Parent
let mixed: Bool = same(child, parent)
class Unrelated {}
class Guard<T: Read> {}
fun alternative<T>(value: Guard<T>, extra: Int = 0): Bool = true
fun alternative<T>(value: T): Int = 1
let rejected = alternative<Unrelated>(Unrelated())
extern "C" { fun stop(): Never }
let selected = alternative<Unrelated>(stop(), extra: 1)

class Sibling: Parent {}
fun three<T>(a: T, b: T, c: T): T = a
let late: Bool = three(Child(), Sibling(), Parent())

class Closed where Missing: Read {}
let closedAnnotation: Closed

fun statements(items: [Int]) {
    var total = 0; var count = 0
    for item in items {
        if item < 0 { continue }
        total += item
        count += 1
    }
    while let next = iterator.next() {
        process(next)
    }
    loop {
        if done() { break }
    }
    defer { cleanup() }
    if let user: User = lookup(id) {
        greet(user)
    } else if id == 0 {
        return
    }
    else {
        return -1
    }
    flags |= 0x10
    bits <<= 2
    shifted >>= 1
    obj.field = 3
    arr[0] = arr[1]
    return total / count
}

fun patterns(e: Expr) = match e {
    .Int(0) | .Int(1) -> "small"
    .Int(n) if n < 0 -> "negative"
    Expr.Binary(lhs, _, rhs) -> "binary"
    Some(x) -> "some"
    is Literal as lit -> lit.text
    -1 -> "minus one"
    "s" | 'c' | 2.5 | true | none -> "literal"
    other -> {
        log(other)
        "unknown"
    }
}

fun unsafeStuff() {
    let p = unsafe { raw.offset(4) }
}

// A struct or enum that holds itself inline, through fields, payloads,
// tuples or optionals, has no finite size (3.37). Arrays, classes and
// function values hold their values elsewhere.
struct Node(value: Int, next: Link)
struct Link(node: Node)
struct Chain(value: Int, next: Chain?)
struct Paired(inner: (Paired, Int))

struct Box<T>(value: T)
struct Looped<T>(inner: Box<Looped<T>>)
struct Grow<T>(inner: Grow<Box<T>>)
// Each branch grows its own way.
struct Branching<T>(a: Branching<[T]>, b: Branching<Box<T>>, c: Branching<(T, T)>)

struct Body {
    var me: Body? = none
}

enum Expr {
    num(Int)
    add(Expr, Expr)
}

// A struct that holds one of these without being on its cycle is not
// reported again.
struct Uses(node: Node)

// These are fine.
struct Nested(a: Box<Box<Int>>, kids: [Nested], f: fun(Nested) -> Int)
class Shape(let next: Shape?)
struct Holder(shape: Shape)
enum Tree {
    leaf(Int)
    node(kids: [Tree])
}
struct Wrapper(inner: Box<Wrapper2>)
struct Wrapper2(items: [Wrapper])

// Tuples that share parts are walked once each.
type T0 = Int
type T1 = (T0, T0)
type T2 = (T1, T1)
type T3 = (T2, T2)
type T4 = (T3, T3)
type T5 = (T4, T4)
type T6 = (T5, T5)
type T7 = (T6, T6)
type T8 = (T7, T7)
type T9 = (T8, T8)
type T10 = (T9, T9)
type T11 = (T10, T10)
type T12 = (T11, T11)
type T13 = (T12, T12)
type T14 = (T13, T13)
type T15 = (T14, T14)
type T16 = (T15, T15)
type T17 = (T16, T16)
type T18 = (T17, T17)
type T19 = (T18, T18)
type T20 = (T19, T19)
type T21 = (T20, T20)
type T22 = (T21, T21)
type T23 = (T22, T22)
type T24 = (T23, T23)
type T25 = (T24, T24)
type T26 = (T25, T25)
type T27 = (T26, T26)
type T28 = (T27, T27)
type T29 = (T28, T28)
type T30 = (T29, T29)
type T31 = (T30, T30)
type T32 = (T31, T31)
type T33 = (T32, T32)
type T34 = (T33, T33)
type T35 = (T34, T34)
type T36 = (T35, T35)
type T37 = (T36, T36)
type T38 = (T37, T37)
type T39 = (T38, T38)
type T40 = (T39, T39)
struct Shared(value: T40)

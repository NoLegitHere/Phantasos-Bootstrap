// `own` and `borrow` parameters pass like default ones. `inout` parameters
// (other than `mut fun` receivers), conventions on struct fields, and
// functions with `own` parameters used as values are still rejected.

struct Owned(text: own String)

fun inout_(x: inout Int) {}

fun take(text: own String): String = text

fun peek(text: borrow String): String = text.clone()

fun main() {
    print(take("a"))
    print(peek("b"))
    let f: fun(String) -> String = take
    let g: fun(String) -> String = peek
}

// Tuple values: passing and returning in registers and by address, nested
// tuples, struct and String elements, element assignment, mut fun calls
// through an element, destructuring, and a swap.

struct Counter(var count: Int) {
    mut fun bump() { count += 1 }
}

fun pair(a: Int8, b: Bool): (Int8, Bool) = (a, b)

fun swap(t: (Int, String)): (String, Int) = (t.1.clone(), t.0)

fun wide(a: Int, b: Int, c: Int): (Int, (Int, Int), UInt8) = (a, (b, c), 7)

fun sum(t: (Int, (Int, Int), UInt8)): Int = t.0 + t.1.0 + t.1.1 + Int(t.2)

fun main(): Int {
    let p = pair(-4, true)
    print(Int(p.0))
    print(p.1)
    let s = swap((3, "three"))
    print(s.0)
    print(s.1)
    var w = wide(1, 2, 3)
    print(sum(w))
    w.1.0 = 10
    w.2 = 0
    print(sum(w))
    var u = (Counter(count: 5), "counter")
    u.0.bump()
    u.0.bump()
    print(u.1)
    print(u.0.count)
    let (a, b, c) = w
    print(a + b.0 + b.1 + Int(c))
    let x = 1
    let y = 2
    let (first, second) = (y, x)
    return first * 10 + second   // 21
}

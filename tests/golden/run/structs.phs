// Struct values: fields of every scalar width, nesting, String fields, and
// labeled arguments in any order. Fields are laid out by decreasing alignment
// (abi.md A.2) but always read back by name.

struct Small(a: Int8, b: UInt8, c: Bool)
struct Mixed(s: Int16, u: UInt32, i: Int32, w: UInt64)
struct Pair(left: Small, right: Mixed)
struct Named(label: String, n: Int)

fun small(a: Int8): Small = Small(a: a, b: 250, c: a < 0)

fun main(): Int {
    let m = Mixed(w: 18446744073709551615, i: -5, u: 4294967295, s: -300)
    print(Int(m.s))
    print(UInt(m.u))
    print(Int(m.i))
    print(UInt(m.w))
    let s = small(-3)
    print(Int(s.a))
    print(UInt(s.b))
    print(s.c)
    let p = Pair(left: s, right: m)
    print(Int(p.right.i))
    print(UInt(p.left.b))
    let copy = p
    print(copy.left.c)
    var acc = Named(label: "loop", n: 0)
    var i = 0
    while i < 4 {
        acc = Named(label: acc.label.clone(), n: acc.n + i)
        i += 1
    }
    print(acc.label)
    print(acc.n)
    let chosen: Named = if acc.n > 5 { Named(label: "big", n: 1) } else { acc }
    print(chosen.label)
    return chosen.n + Int(p.left.a)   // 1 - 3
}

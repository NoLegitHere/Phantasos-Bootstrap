// Arrays (3.33): the built-in members `count`, `isEmpty`, `append` and
// `removeLast`, and `for` over arrays and ranges. Ranges work only as the
// subject of a `for` loop.

fun valid(values: inout [Int8], limit: UInt8): Int {
    var total = values.count
    if values.isEmpty { values.append(1) }
    let last: Int8? = values.removeLast()
    for value in values { total += Int(value) }
    for small in 0..<limit { total += Int(small) }
    for index in 1..3 { total += index }
    return total + Int(last ?? 0)
}

fun errors(values: [Int], n: Int, maybe: [Int]?) {
    let size = values.size
    let method = values.append
    var copy = [1]
    copy.append("one")
    copy.append(1, 2)
    let last = copy.removeLast(0)
    for i in n {}
    for i in maybe {}
    for i in 0..<"ten" {}
    let range = 0..<n
}

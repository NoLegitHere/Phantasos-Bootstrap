// A function value is its thunk's address and a null environment. The thunk
// takes the environment in rdi and the arguments after it, and calls the
// function; an indirect call loads the environment like any argument and
// calls the code through r11.

fun add(a: Int, b: Int): Int = a + b

fun apply(f: fun(Int, Int) -> Int, x: Int): Int = f(x, 2)

fun main(): Int = apply(add, 40)

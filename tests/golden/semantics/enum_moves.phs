// A payload owns its value, so building a case moves it (3.30, 3.34).
enum Msg {
    text(String)
    quit
}

fun moves(borrowed: String) {
    let s = "hi"
    let m = Msg.text(s)
    print(s)
    let n: Msg = .text(borrowed)
    let copy: Msg = .text(borrowed.clone())
}

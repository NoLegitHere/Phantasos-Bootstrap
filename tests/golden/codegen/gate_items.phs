// Declarations outside the subset. Bodies of unsupported signatures are not
// reported again.

class Shape {}

let limit = 3

extern "C" {
    fun abs(x: Int32): Int32
}

type Count = Int

fun float(x: Float64): Float64 = x * 2.0

fun optional(x: Unit?): Int = 0

fun throwing() throws {}

fun inout_(x: inout Int) {}

fun defaults(x: Int = 1): Int = x

fun array(xs: [Int]): Int = xs[0]

fun main() {}

// Optionals stage0 cannot compile yet: of Unit, compared as structs, tuples
// or Strings, and a struct that holds itself through an optional.

struct Point(let x: Int, let y: Int)
struct Node(let value: Int, let next: Node?)

fun unit(x: Unit?) {}

fun main() {
    let p: Point? = none
    let missing = p == none
    let s: String? = "s"
    let named = s == "s"
    let t: (Int, Int)? = (1, 2)
    let pair = t == none
}

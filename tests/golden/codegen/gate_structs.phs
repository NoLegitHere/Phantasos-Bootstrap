// Structs outside the subset: only plain structs whose fields all come from
// the primary constructor and have supported types. A struct that
// holds a rejected struct is rejected too.

struct Empty()

struct Defaulted(x: Int = 1)

struct Real(x: Float64)

struct Nothing(x: ())

struct Holder(real: Real)

struct Counter(count: Int) {
    var extra: Int = 0
    static fun zero(): Int = 0
}

struct Point(x: Int, y: Int)

fun main(): Int {
    let p = Point(x: 1, y: 2)
    let h = Holder(real: Real(x: 1.0))
    return p.x + Counter(count: 1).count
}

// Each checked operation and the trap it can reach: jo for 64-bit signed
// arithmetic, jb for 64-bit unsigned add and sub, a range check for narrow
// results, and the zero and MIN / -1 checks before a division.

fun signed(a: Int, b: Int): Int = a + b - a * b / b % a

fun unsigned(a: UInt, b: UInt): UInt = a + b - a * b / b % a

fun narrow(a: Int8, b: UInt16): Int8 = a * Int8.truncating(b) &+ -a

fun main(): Int = signed(7, 3) + Int.truncating(unsigned(7, 3)) + Int(narrow(2, 3))

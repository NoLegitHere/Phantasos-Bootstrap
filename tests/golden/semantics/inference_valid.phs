interface Read { fun read(): Int }
interface Flag { fun flag(): Bool }
class Value: Read, Flag { fun read() = 1; fun flag(): Bool = true }
fun identity<T>(value: T): T = value
fun same<T>(first: T, second: T): T = first
fun bounded<T: Read & Flag>(value: T): T = value
fun constrained<T>(value: T): T where T: Read = value
class Box<T: Read>(let value: T) {}
let byte: Int8 = 1
let first: Int8 = same(1, byte)
let last: Int8 = same(byte, 1)
let array: [Int8] = same([1], [byte])
let inferred: Bool = identity(true)
let checked: Value = bounded(Value())
let whereChecked: Value = constrained(Value())
let box: Box<Value> = Box(Value())
fun choose(value: Int): Bool = true
fun choose<T>(value: T): T = value
let preferred: Bool = choose(1)

class Unrelated {}
class Guard<T: Read> {}
fun alternative<T>(value: Guard<T>): Bool = true
fun alternative<T>(value: T): Int = 1
let selected: Int = alternative<Unrelated>(Unrelated())
let selectedAgain: Int = alternative<Unrelated>(Unrelated())
open class Parent {}
class Child: Parent {}
let child: Child?
let parent: Parent
let mixed: Parent? = same(child, parent)
let mixedReverse: Parent? = same(parent, child)

type CopyTrait = Copy
fun protocol<T>(x: T, marker: CopyTrait): T = x
let number: Int = 1
let pendingProtocol: Bool = protocol(number, number)
class Sibling: Parent {}
fun three<T>(a: T, b: T, c: T): T = a
let late: Parent = three(Child(), Sibling(), Parent())

class Closed where Value: Read {}
let closedAnnotation: Closed
interface Dependent<U> {}
class Recursive<T> where Recursive<[T]>: Dependent<T> {}
let recursiveAnnotation: Recursive<Int>

struct Point(var x: Int8) {
    fun read(value: Int8 = 1): Int8 = self.x
    static fun invalid(): Int8 = x
    static let flag: Bool = true
}
let point = Point(1)
let missing = point.nope
let instance = Point.x
let typeAccess = point.flag
let method = Point.read()
let argument = point.read(true)
let range = point.read(128)
let result: Bool = point.read()
fun write(value: Point) { value.x = false }

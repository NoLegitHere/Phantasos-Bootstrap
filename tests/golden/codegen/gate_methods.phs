// Methods outside the subset: static methods (which reject their struct),
// unsupported signatures, methods of rejected structs, and method values.

struct Factory(seed: Int) {
    static fun zero(): Factory = Factory(seed: 0)
}

struct Counter(var count: Int) {
    fun real(): Float64 = 1.0
    fun get(): Int = count
}

struct Rejected(x: Float64) {
    fun get(): Float64 = x
}

fun main(): Int {
    var c = Counter(count: 1)
    let f = c.get
    let r = Rejected(x: 2.0).get()
    return c.get()
}

let badBinding: Bool = 1
let badOperator = true + false
let badLiteral: Int8 = 128
let small: Int8 = 1
let badConversion: Int64 = small
let badFloat: Float32 = 1.0e39
let badUnsigned: UInt8 = -1
fun defaults(flag: Bool = 1): Bool = 0
fun returns(): Int { return }
fun statements() {
    var count = 1
    count = false
    if 1 {}
    while "bad" { break }
    match count { 1 if 2 -> () }
}
fun opaque(): Bool = true
fun logicalCalls() {
    if 1 && opaque() {}
    if opaque() && 1 {}
    if 1 || opaque() {}
    if opaque() || 1 {}
}
fun discardedLiterals() {
    9223372036854775808
    (9223372036854775808 + 1)
    return
}
struct BadStruct(value: Int8) { fun read(): Bool = value }
class BadClass(let value: Int8) { fun read(): Bool = value }
actor BadActor(var value: Int8) { fun read(): Bool = value }
fun opaqueNumber(): Int = 1
let badDeferredArithmetic = true + opaqueNumber()
let badDeferredBits = opaqueNumber() & 1.0
fun badDeferredCompound() { var flag = true; flag += opaqueNumber() }

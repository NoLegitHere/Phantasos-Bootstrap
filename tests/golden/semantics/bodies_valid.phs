interface Source { type Item; fun get(): Item }
class Box<T>(let value: T): Source { type Item = T; fun get() = value }
fun read<T: Source>(x: T): T.Item = x.get()
fun identity<T>(x: T) = x
let number: Int = read(Box(1))
let flag: Bool = identity(true)
interface Clone { fun clone(x: Self): Self = x }
class Value: Clone {}
fun clone<T: Clone>(x: T): T = x.clone(x)
let cloned: Value = clone(Value())
interface Has { type Item; var value: Item }
class Cell<T>(var value: T): Has { type Item = T }
fun value<T: Has>(x: T) = x.value
let field: Int = value(Cell(1))

// Branches, loops, short-circuit logic and branch results.

fun classify(x: Int): Int {
    if x < 0 { return -1 } else if x == 0 { return 0 } else if x < 10 { return 1 }
    return 2
}

fun loops(n: Int): Int {
    var total = 0
    var i = 0
    loop {
        i += 1
        if i > n { break }
        if i % 2 == 0 { continue }
        while total < i && !(total == 3) {
            total += 1
        }
    }
    return total
}

fun pick(c: Bool, d: Bool): Int = if c || d { 7 } else { 9 }

fun main(): Int {
    let x: Int
    if pick(true, false) == 7 { x = 100 } else { x = 200 }
    let y: Int = if x > 150 { 1 } else if x > 50 { 2 } else { 3 }
    return x + y + classify(5) + loops(5)
}

let asComparisons = foo(x as Int < y, z > w)
let isComparisons = foo(x is Int < y, z >= w)
let parenthesized = foo(x as Int < y, z > (w))
let callback = x as fun(A<B>) -> Int < y
let nested = x is fun([A<B>], fun(C) -> D) -> Result<T> throws(Error<U>) < y
let optional = x as Container<T> ? ? + y
fun alternatives(x: Int) = match x {
    1 |
    2 |
    3 -> 0
    _ -> 1
}
fun controls(x: Value) {
    if x is Box<Int> {}
    while x is Box<Outer<Int>>? {}
    for item in x as Box<Int> {}
    let result = match x as Box<Int> { _ if x is Box<Int> -> 0 }
}

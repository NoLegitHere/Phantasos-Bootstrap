// Every construct in the stage0 code generation subset.

fun pick(c: Bool, a: Int32, b: Int32): Int32 = if c { a } else { b }

fun bits(x: UInt8): UInt8 {
    var y: UInt8 = x & 15
    y |= 1
    y ^= ~x
    return y &+ 250
}

fun count(limit: Int64): Int64 {
    var n: Int64 = 0
    loop {
        n += 1
        if n >= limit { break }
        if n % 2 == 0 { continue }
    }
    return n
}

fun deferred(c: Bool): Int {
    let x: Int
    if c { x = 1 } else { x = 2 }
    let y: Int = if c { 0 } else {
        let z = x * 2
        z + 1
    }
    return -y
}

fun noop() {}

fun spin(): Never {
    loop {}
}

fun logic(a: Bool, b: Bool): Bool = !a && (b || a == b)

fun main(): Int {
    noop()
    let total = pick(true, 1, 2)
    if total != 1 { spin() }
    let w: Int = if logic(true, false) { 3 } else { 4 }
    return w + deferred(false) + Int(count(5))
}

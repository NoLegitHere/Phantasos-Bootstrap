// Tuple types, literals, element access and destructuring.
type Pair = (Int, Bool)
type Nested = ((Int8, Int8), [String], (Int, Int)?,)
type Grouped = (fun() -> Int)?

fun swap(p: (Int, Bool)): (Bool, Int) = (p.1, p.0)

fun main() {
    let unit = ()
    let grouped = (1)
    let pair = (1, true)
    let trailing = (
        1,
        2,
    )
    let deep = ((1, 2), 3).0.1
    var (x, y) = swap(pair)
    let (a, b, c): (Int, Int, Int) = (1, 2, 3)
    x = (a, b).0 + c
}

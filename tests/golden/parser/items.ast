      Returns Int32
  Class Node vis=public mods=abstract
    Generic T: Comparable & Hashable
    Ctor
      Param let value: T
    Super Base()
      Name value
    Super Visitable
    Where T: Sendable
    Var children vis=private: [Node<T>]
      Array
    Let MAX mods=static: Int
      Int 64
    Const VERSION
      Int 1
    Init
      Param value: T
      Param count: Int
        Default
          Int 0
      Throws InitError
      Block
        Call
          Super
          Name value
    Fun visit mods=abstract
      Param v: inout Visitor
    Fun size mods=final
      Returns Int
      ExprBody
        Member .count
          Name children
    Fun push mods=mut
      Param child: own Node<T>
      Body
        Block
          Call
            Member .append
              Name children
            Name child
  Interface Container
    TypeAlias Item: Equatable
    TypeAlias Index = Int
    Fun get
      Param i: Index
      Returns Item?
    Fun isEmpty
      Returns Bool
      Body
        Block
          Return
            Binary Eq
              Call
                Name count
              Int 0

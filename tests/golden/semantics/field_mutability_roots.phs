// Borrows hold through receivers of unknown storage and unwrapped targets, and
// any computed value, such as an array literal, is a temporary.

struct Slot(var a: Int) {
    mut fun bump() { a += 1 }
}
interface Has {
    var value: Int
    fun reset() { value = 0 }
}
fun change<T: Has>(x: T) { x.value = 1 }
class Holder(let value: Int?, var spare: Int?) {}
fun unwrap(h: Holder) {
    h.value! = 2
    h.spare! = 3
}
fun literals() {
    [Slot(1)][0].a = 2
    [Slot(1)][0].bump()
}

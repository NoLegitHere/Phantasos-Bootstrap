// Functions that return several values as a tuple: floored division with
// its remainder, and the extended Euclidean algorithm.

fun divmod(a: Int, b: Int): (Int, Int) {
    var q = a / b
    var r = a % b
    if r != 0 && (r < 0) != (b < 0) {
        q -= 1
        r += b
    }
    return (q, r)
}

// Returns (g, x, y) with a * x + b * y == g, the greatest common divisor.
fun euclid(a: Int, b: Int): (Int, Int, Int) {
    if b == 0 { return (a, 1, 0) }
    let (q, r) = divmod(a, b)
    let (g, x, y) = euclid(b, r)
    return (g, y, x - q * y)
}

fun main(): Int {
    let (q, r) = divmod(17, 5)
    print(q)
    print(r)
    let negative = divmod(-17, 5)
    print(negative.0)
    print(negative.1)
    let (g, x, y) = euclid(240, 46)
    print(g)
    print(x)
    print(y)
    print(240 * x + 46 * y)
    var digits = (0, 0)
    var n = 9045
    while n > 0 {
        let (rest, digit) = divmod(n, 10)
        digits.0 += 1
        digits.1 += digit
        n = rest
    }
    print(digits.0)
    return digits.1   // 9 + 0 + 4 + 5
}

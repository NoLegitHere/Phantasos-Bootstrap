// Tuples have two or more unlabeled elements; destructuring names two or
// more plain bindings with 'let' or 'var'.
fun main() {
    let one = (1,)
    let labeled = (x: 1, y: 2)
    let oneType: (Int,) = 1
    let labeledType: (x: Int, Int) = 1
    let (single) = 1
    const (k, l) = (1, 2)
    let (m, n)
    let ((p, q), r) = 1
}

fun indexes(t: (Int, Int)) {
    let a = t.01
    let b = t.1_0
    let c = t.0x1
    let d = t.1e5
    let e = t?.0
}

fun swap() {
    var a = 1
    var b = 2
    (a, b) = (b, a)
    ((a, b)) += (1, 1)
}

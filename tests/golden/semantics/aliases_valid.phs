type Small = Later
type Later = Int8
type Maybe = Small?
let value: Small = 1
fun preserve(value: Small): Maybe = value
let optional = preserve(value)
let converted = Small.truncating(1000)
let checked = Later.checked(1000)
class Types { type Number = UInt16; class Nested {} }
type Container = Types
type Number = Container.Number
type Nested = Container.Nested
let numeric = Number(60000)
let qualified = Container.Number(1)
let nominal: Nested = Container.Nested()
type Void = ()
fun cleanup(): Void? { return }

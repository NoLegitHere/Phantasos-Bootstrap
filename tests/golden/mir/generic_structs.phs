// Generic structs: a layout per instance, named after its type arguments, and
// a function per method instance, named after its receiver's type, with an
// implicit receiver inside an instance and a generic method.

struct Box<T>(var value: T) {
    fun get(): T = value

    mut fun set(x: T) { value = x }

    fun twice(): (T, T) = (get(), value)

    fun with<U>(u: U): Box<(T, U)> = Box(value: (value, u))
}

fun main(): Int {
    var b = Box(value: 1)
    b.set(2)
    let w = b.with(true)
    if w.get().1 { return b.twice().0 }
    return 0
}

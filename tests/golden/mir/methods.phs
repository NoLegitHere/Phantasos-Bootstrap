// A method takes its receiver as a hidden first parameter. A `mut fun`
// receiver is inout: a nested receiver is read before the call and rebuilt
// after it.

struct Point(var x: Int, var y: Int) {
    fun sum(): Int = x + y
    mut fun shift(by: Int) {
        x += by
        self.y = sum()
    }
}
struct Line(var from: Point, var to: Point) {
    mut fun stretch() { to.shift(by: from.sum()) }
}

fun main(): Int {
    var line = Line(from: Point(x: 1, y: 2), to: Point(x: 3, y: 4))
    line.stretch()
    line.from.shift(by: 1)
    return line.to.y + line.from.sum()
}

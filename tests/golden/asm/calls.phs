// The System V calling convention: six arguments in registers, the rest on
// the stack with the stack kept 16-byte aligned, and a Never call that ends
// its block with ud2.

fun many(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Bool): Int {
    if i { return g - h }
    return a + b + c + d + e + f
}

fun stop(): Never {
    loop {}
}

fun main(): Int {
    let r = many(1, 2, 3, 4, 5, 6, 7, 8, true)
    if r != -1 { stop() }
    return r
}

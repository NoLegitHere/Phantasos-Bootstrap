// Functions that build functions: an adder factory, composition, and a
// closure that returns a closure, so the inner one sees captures from two
// levels out.

fun makeAdder(n: Int): fun(Int) -> Int = { x -> x + n }

fun compose(f: fun(Int) -> Int, g: fun(Int) -> Int): fun(Int) -> Int = { x -> g(f(x)) }

fun twice(f: fun(Int) -> Int): fun(Int) -> Int = compose(f, f)

// scaler(a)(b) multiplies by a and then adds b.
fun scaler(a: Int): fun(Int) -> fun(Int) -> Int = { b -> { x -> x * a + b } }

fun main(): Int {
    let add5 = makeAdder(5)
    let add10 = twice(add5)
    print(add5(1))
    print(add10(1))
    let double = { x: Int -> x * 2 }
    let doubleThenAdd5 = compose(double, add5)
    print(doubleThenAdd5(10))
    let affine = scaler(3)(4)
    print(affine(5))
    let offset = 100
    let shifted = compose(affine, { x -> x + offset })
    print(shifted(1))
    return twice(twice(makeAdder(10)))(2)
}

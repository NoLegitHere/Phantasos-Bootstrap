// Spec 1.3: newlines inside generic lists and after ':' / '=' / '->' / '.'
// continue the declaration.

import std.
    collections.
    map as m

type Qualified = geometry.
    shapes.Point

fun qualifiedPattern(e: Expr) = match e {
    Expr.
        Int(0) -> 1
    _ -> 0
}

class Table<
    K: Hashable,
    V
> : Container<
    K,
    V,
> {
    let size:
        Int = 0
}

type Nested = Box<Box<Int,>>

type Alias =
    Map<
        String,
        Int
    >

type Callback = fun(Int) ->
    Bool

fun make(): Map<
    String,
    Int
> {
    let empty = Map<
        String,
        Int
    >()
    let cmp = a <
        b
    let next = c
    return empty
}

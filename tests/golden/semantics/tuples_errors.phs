// Tuple type errors: element types, arity, missing elements, non-tuple
// receivers and destructuring shapes. Tuples are invariant: only literal
// elements take their type from context.
fun main() {
    let t = (1, 2)
    let wrong: Bool = t.0
    let missing = t.2
    let range: (Int8, Int8) = (1, 300)
    let arity: (Int, Int) = (1, 2, 3)
    let invariant: (Int, Bool) = t
    let narrowed: (Int8, Int8) = t
    let scalar = 5
    let notTuple = scalar.0
    let maybe: (Int, Int)? = t
    let unwrapped = maybe.0
    let whole: Int = (1, 2)
    let (e, f) = 5
    let (g, h, i) = t
    let (j, k): (Int, Int, Int) = (1, 2, 3)
}

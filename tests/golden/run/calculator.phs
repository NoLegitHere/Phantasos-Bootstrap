// A dispatch table: operators held in struct fields and picked by a symbol,
// evaluating an expression one operator at a time.

fun add(a: Int, b: Int): Int = a + b
fun sub(a: Int, b: Int): Int = a - b
fun mul(a: Int, b: Int): Int = a * b
fun div(a: Int, b: Int): Int = a / b

struct Operator(symbol: String, apply: fun(Int, Int) -> Int)

struct Table(plus: Operator, minus: Operator, times: Operator, over: Operator) {
    // The operator for code 0 to 3.
    fun pick(code: Int): Operator {
        if code == 0 { return plus.clone() }
        if code == 1 { return minus.clone() }
        if code == 2 { return times.clone() }
        return over.clone()
    }
}

// Applies the operator for code to value and operand, and prints the operator.
fun step(table: Table, value: Int, code: Int, operand: Int): Int {
    let op = table.pick(code)
    print(op.symbol)
    return op.apply(value, operand)
}

fun main(): Int {
    let table = Table(
        plus: Operator(symbol: "+", apply: add),
        minus: Operator(symbol: "-", apply: sub),
        times: Operator(symbol: "*", apply: mul),
        over: Operator(symbol: "/", apply: div))
    // ((7 + 5) * 3 - 6) / 5
    var value = step(table, 7, 0, 5)
    value = step(table, value, 2, 3)
    value = step(table, value, 1, 6)
    value = step(table, value, 3, 5)
    print(value)
    // Division by zero still panics through a function value.
    return step(table, value, 3, 0)
}

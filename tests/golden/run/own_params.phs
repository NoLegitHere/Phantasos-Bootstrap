// An `own` parameter belongs to the callee, so a closure can capture it even
// when its type is not Copy. Stage0 passes `own` and `borrow` parameters the
// same way as default ones.

struct Label(text: String, width: Int) {
    fun prefixed(prefix: own String): fun() -> String = { -> prefix.clone() }

    fun wider(extra: borrow Int): Int = width + extra
}

fun greeter(name: own String): fun() -> String = { -> name.clone() }

fun keep(label: own Label): fun() -> Label = { -> label.clone() }

fun add(a: borrow Int, b: own Int): Int = a + b

fun main(): Int {
    let hello = greeter("hello")
    print(hello())
    let kept = keep(Label("boxed", 5))
    print(kept().text)
    print(kept().wider(2))
    let tag = Label("x", 1).prefixed("tag")
    print(tag())
    return add(40, 2)
}

struct @Flags { on: bool +4, level: i8 +5, mask: u32 +0 } size 8 align 4

struct @Point { x: i64 +0, y: i64 +8 } size 16 align 8

struct @Label { text: string +0, at: @Point +16 } size 32 align 8

fun @origin() -> @Point {
bb0:
    %0: i64 = const 0
    %1: i64 = const 0
    %2: @Point = make %1, %0
    ret %2
}

fun @width(%0: @Label) -> i64 {
bb0:
    %1: @Point = field %0, at
    %2: i64 = field %1, x
    ret %2
}

fun @main() -> i64 entry {
bb0:
    %0: u32 = const 255
    %1: i8 = const -1
    %2: bool = const true
    %3: @Flags = make %2, %1, %0
    %4: @Flags = copy %3
    %5: string = str "here"
    %6: @Point = call @origin()
    %7: @Label = make %5, %6
    %8: @Label = copy %7
    %9: bool = field %4, on
    condbr %9, bb1, bb2
bb1:
    %10: string = field %8, text
    print %10
    br bb2
bb2:
    %11: i64 = call @width(%8)
    %12: i8 = field %4, level
    %13: i64 = widen %12
    %14: i64 = add %11, %13
    ret %14
}

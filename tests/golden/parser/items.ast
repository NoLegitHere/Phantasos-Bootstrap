    Generic T
    Case Eof
    Case Ident(String)
    Case Number(value: Int64, radix: UInt8)
    Fun isEof
      Returns Bool
      ExprBody
        Match
          SelfValue
          Arm .Eof
            Bool true
          Arm _
            Bool false

// A comparator chosen at run time and passed to a three-element sort,
// returned from a function and kept in a tuple.

fun ascending(a: Int, b: Int): Bool = a < b
fun descending(a: Int, b: Int): Bool = a > b
fun byLastDigit(a: Int, b: Int): Bool = a % 10 < b % 10

fun comparator(code: Int): fun(Int, Int) -> Bool {
    if code == 0 { return ascending }
    if code == 1 { return descending }
    return byLastDigit
}

// Sorts three values with a sorting network of three compare-and-swaps.
fun sort3(values: (Int, Int, Int), before: fun(Int, Int) -> Bool): (Int, Int, Int) {
    var (a, b, c) = values
    if before(b, a) {
        let t = a
        a = b
        b = t
    }
    if before(c, b) {
        let t = b
        b = c
        c = t
    }
    if before(b, a) {
        let t = a
        a = b
        b = t
    }
    return (a, b, c)
}

fun show(values: (Int, Int, Int)) {
    print(values.0)
    print(values.1)
    print(values.2)
}

fun main(): Int {
    let input = (42, 7, 19)
    var code = 0
    while code < 3 {
        show(sort3(input, comparator(code)))
        code += 1
    }
    let pair = (comparator(1), input)
    let sorted = sort3(pair.1, pair.0)
    return sorted.0 - sorted.2
}

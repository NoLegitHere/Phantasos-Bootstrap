// Narrow types wrap with &+ and &*, truncate on request and widen freely.

fun main(): Int {
    let a: Int8 = 100
    let b = a &+ 100              // -56
    let c: UInt8 = 200
    let d = c &* 2                // 144
    let e = UInt8.truncating(513) // 1
    let f: UInt16 = 65535
    let g = Int(b) + Int(d) + Int(e) + Int(f) - 65535   // 89
    return g
}

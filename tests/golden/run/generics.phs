// Generic functions: values of any type through identity, pairs and swaps,
// a recursive generic function, and a generic function applying a function
// value or closure.

fun identity<T>(x: T): T = x

fun pair<A, B>(a: A, b: B): (A, B) = (a, b)

fun swap<A, B>(p: (A, B)): (B, A) = (p.1, p.0)

fun repeat<T>(x: T, times: Int, f: fun(T) -> T): T {
    if times == 0 { return x }
    return repeat(f(x), times - 1, f)
}

fun first<T>(items: (T, T, T), pick: fun(T) -> Bool, fallback: T): T {
    if pick(items.0) { return items.0 }
    if pick(items.1) { return items.1 }
    if pick(items.2) { return items.2 }
    return fallback
}

fun double(x: Int): Int = x * 2

fun main(): Int {
    print(identity(7))
    print(identity("seven"))
    print(identity(true))
    let p = swap(pair("left", 10))
    print(p.0)
    print(p.1)
    print(repeat(1, 10, double))
    print(repeat("a", 3, { s: String -> s.clone() }))
    print(first((3, 8, 12), { n: Int -> n > 5 }, 0))
    print(first((false, false, true), { b: Bool -> b }, false))
    let nested = swap(swap(pair(UInt8(1), (false, -2))))
    print(UInt(nested.0))
    print(nested.1.1)
    return identity(3)
}

// Function values: a top-level function named as a value, passed, returned,
// stored in a struct field and a tuple element, and called indirectly.

fun twice(x: Int): Int = x * 2
fun add(a: Int, b: Int): Int = a + b
fun add(a: Int): Int = a + 1
fun greet() { print("hello") }

fun apply(f: fun(Int) -> Int, x: Int): Int = f(x)

fun pick(first: Bool): fun(Int) -> Int {
    return if first { twice } else { add }
}

struct Op(f: fun(Int, Int) -> Int, name: String)

fun main(): Int {
    let say = greet
    say()
    let op = Op(add, "add")
    let pair = (pick(true), 3)
    return apply(add, 10) + pick(false)(1) + op.f(2, 3) + pair.0(pair.1)
}

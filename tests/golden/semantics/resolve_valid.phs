interface Trait { type Element }
class Box<T>(let value: T) {
    init { value }
    fun read(): T = value
    class Nested {}
}
fun forward(x: Int) = overloaded(x)
fun overloaded(x: Int) = x
fun overloaded(x: String) = x.clone()
extern "C" { fun foreign(x: Int): Int }
let nested: Box.Nested = Box.Nested()
let saved = Box<Int>(1)
let captured = overloaded
let outer = 10
fun scopes(first: Int = outer, second: Int = first) {
    let outer = outer + second
    if let x = saved { x.read() }
    while let x = saved { x.read(); break }
    for x in [1, 2] { x }
    match saved { .Some(x) | .Other(x) if x > 0 -> x }
    defer { outer }
}

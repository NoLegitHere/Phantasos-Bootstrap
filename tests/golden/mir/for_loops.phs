// `append` reserves room for one more element, `removeLast` takes the last
// one out, and `for` loops step a counter through an array or a range.

fun main(): Int {
    var a: [Int] = []
    a.append(1)
    var total = a.removeLast() ?? 0
    for x in [2, 3] { total += x }
    for i in 1..3 {
        if i == 2 { continue }
        total += i
    }
    return total
}

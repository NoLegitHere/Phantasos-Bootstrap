// Arrays stage0 cannot compile yet: `append` and `removeLast` through `?.`,
// comparisons, arrays of Unit, loops over them and structs that hold
// themselves through an array.

struct Tree(let kids: [Tree])

fun main() {
    var a = [1, 2]
    var maybe: [Int]? = [3]
    maybe?.append(4)
    let last = maybe?.removeLast()
    for u in [()] {}
    let same: Bool = a == [1, 2]
    let o: [Int]? = none
    let missing: Bool = o != none
    let units: [Unit] = []
}

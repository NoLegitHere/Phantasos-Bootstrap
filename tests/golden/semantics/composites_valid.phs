type Bytes = [UInt8]
let bytes: Bytes = ([0, 255])
let first = bytes[0]
let nested: [[Int8]] = [[1], [2, 3]]
let element = nested[0][0]
struct Point(x: Int8, y: Int8 = 0) {}
type Position = Point
let point = Point(1)
let alias: Position = Position(y: 2, x: 3)
let points: [Point] = [point, alias]
type Pointer = *mut Point
let pointer: Pointer
extern "C" { fun produce(): fun(Int8) -> Bool }
let callback = produce()
let result = callback(1)
fun take(values: [UInt64]): UInt64 = values[0]
let maximum = take([18446744073709551615])
extern "C" {
    fun stop(): Never
    fun produceOptional(): fun(Int?) -> Int
}
let neverLast = [1, stop()]
let neverFirst = [stop(), 1]
let nestedEmptyFirst = [[], [1]]
let contravariant: fun(Int) -> Int = produceOptional()
let byte: Int8 = 1
let inferredLeft = [[1], [byte]]
let inferredRight = [[byte], [1]]
let deferredEquality = [1] == [true]

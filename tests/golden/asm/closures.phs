// A capturing closure allocates its environment from the runtime and stores
// the captured values into it; its function reads them back through the
// environment pointer, its first parameter. A closure that captures nothing
// has a null environment, and its value's code is its function itself.

struct Pair(a: Int8, b: String)

fun keep(a: Int8, k: Int): fun() -> Int = { -> Int(a) + k }

fun main(): Int {
    let pair = Pair(a: 2, b: "pair")
    let first = { -> pair.a }
    let plain = { x: Int -> x + 1 }
    return keep(first(), 3)() + plain(0)
}

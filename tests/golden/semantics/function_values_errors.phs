// A function value must have exactly the expected function type.
fun inc(x: Int): Int = x + 1
fun neg(x: Int8): Int8 = -x
fun neg(x: Int): Int = -x
fun apply(f: fun(UInt) -> UInt, x: UInt): UInt = f(x)

let wrongResult: fun(Int) -> Bool = inc
let wrongArity: fun(Int, Int) -> Int = inc
let noOverload: fun(Bool) -> Bool = neg
let notAValue: Int = inc
let badArgument = inc
let call = badArgument(true)
let noMatch = apply(neg, 1)

// The M1 target program: exits with 42 once code generation exists.

fun fib(n: Int): Int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fun sumTo(limit: Int): Int {
    var total = 0
    var i = 1
    while i <= limit {
        if i % 3 == 0 || i % 5 == 0 { total += i }
        i += 1
    }
    return total
}

fun main(): Int {
    return fib(10) - sumTo(9) + 10   // 55 - 23 + 10 = 42, the process exit code
}

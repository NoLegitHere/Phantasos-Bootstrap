fun invalidReturn<T>(x: T): Int = x
fun invalidLiteral<T>(x: T): T = true
fun invalidMember<T>(x: T) = x.missing()
interface Read { fun read(): Int }
fun invalidBoundCall<T: Read>(x: T): Int = x.read(true)
interface Source { type Item; fun get(): Item }
class Missing: Source { fun get(): Int = 1 }
interface Has { var value: Int }
class Readonly: Has { let value: Int = 1 }

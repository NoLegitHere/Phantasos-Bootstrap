// Mapping and folding over a fixed set of values with closures. Stage0 has
// no arrays yet, so the values live in a struct with a method per operation.

struct Scores(a: Int, b: Int, c: Int, d: Int) {
    fun map(f: fun(Int) -> Int): Scores = Scores(f(a), f(b), f(c), f(d))

    fun count(matches: fun(Int) -> Bool): Int {
        var n = 0
        if matches(a) { n += 1 }
        if matches(b) { n += 1 }
        if matches(c) { n += 1 }
        if matches(d) { n += 1 }
        return n
    }

    fun fold(initial: Int, combine: fun(Int, Int) -> Int): Int =
        combine(combine(combine(combine(initial, a), b), c), d)

    fun show() {
        print(a)
        print(b)
        print(c)
        print(d)
    }
}

fun main(): Int {
    let raw = Scores(7, 12, 3, 9)
    let curve = 5
    let curved = raw.map({ x -> x + curve })
    curved.show()
    let passMark = 12
    print(curved.count({ x -> x >= passMark }))
    let total = curved.fold(0, { sum, x -> sum + x })
    print(total)
    let best = curved.fold(0, { best, x -> if x > best { x } else { best } })
    print(best)
    return raw.map({ x -> x * 2 }).fold(0, { sum, x -> sum + x }) - 20
}

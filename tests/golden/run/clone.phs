// `x.clone()` makes a copy that can move while `x` stays usable (3.31): a
// String, a struct or tuple of clonable parts, or a Copy value. A struct's
// own `clone` method is called instead.
struct Person(name: String, age: Int)

struct Counter(n: Int) {
    fun clone(): Int = n + 1
}

fun keep(s: own String): Int {
    print(s)
    return 1
}

fun pair(): (String, Int) = ("tuple", 3)

fun main(): Int {
    let greeting = "hello"
    let kept = keep(greeting.clone())
    print(greeting)
    let ada = Person("Ada", 36)
    let twin = ada.clone()
    let moved = ada
    print(twin.name)
    print(moved.name)
    let t = pair().clone()
    print(t.0)
    let next = Counter(4).clone()
    let nested = (greeting.clone(), twin.clone(), (1, "inner")).clone()
    print(nested.1.name)
    print(nested.2.1)
    let inc: fun(Int) -> Int = { x -> x + 1 }
    let again = inc.clone()
    return kept + twin.age - 36 + t.1 + next + 3.clone() + again(29)
}

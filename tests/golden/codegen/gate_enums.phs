// Enums stage0 cannot compile yet: generic ones, ones with methods, without
// cases or implementing interfaces, payloads of unsupported types, and 'match'.
// A struct that holds a rejected enum is rejected too.
enum Opt<T> {
    some(T)
    nothing
}
enum Real {
    value(Float64)
    nothing
}
struct HoldsReal(r: Real)
enum Shape {
    circle(Int)
    fun area(): Int = 1
}
enum Empty {}
interface Named { fun name(): Int }
enum Tagged: Named {
    a
    fun name(): Int = 1
}
enum Tok {
    num(Int)
    plus
}
fun main(): Int {
    let t = Tok.plus
    return match t {
        .num(n) -> n
        .plus -> 0
    }
}

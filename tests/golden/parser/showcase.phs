import std.io
import geometry.shapes as shapes

public sealed interface Shape {
    fun area(): Float64
}

public class Circle(let radius: Float64) : Shape {
    init { require(radius >= 0.0) }
    deinit { io.println("circle freed") }
    override fun area(): Float64 = Float64.pi * radius * radius
}

public open class Animal(let name: String) {
    public open fun speak(): String = "..."
}

public class Dog(name: String) : Animal(name) {
    override fun speak(): String = "Woof"
}

public struct Point(x: Int32, y: Int32)

public enum ParseError { Empty, BadDigit(at: Int) }

fun parse(s: borrow String): Int throws(ParseError) {
    if s.isEmpty { throw ParseError.Empty }
    var value = 0
    for c in s.chars {
        if c < '0' || c > '9' { throw .BadDigit(at: value) }
        value = value * 10 + Int(c.value - '0'.value)
    }
    return value
}

actor Counter {
    var value = 0
    mut fun increment() { value += 1 }
}

async fun main() throws(ParseError) {
    let c = Circle(2.0)
    let s: shared Shape = shared Circle(1.0)
    let n = try parse("42")
    let counter = Counter()
    await counter.increment()
    match s {
        is Circle as ci -> io.println("radius \(ci.radius)")
        _ -> {}
    }
}

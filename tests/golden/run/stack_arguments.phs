// Arguments past the sixth go on the stack; labels may reorder them.

fun weigh(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int): Int =
    a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h + 9 * i

fun main(): Int = weigh(1, 1, 1, 1, 1, 1, 1, 1, 1) - weigh(i: 1, h: 0, g: 0, f: 0, e: 0, d: 0, c: 0, b: 0, a: 0)   // 45 - 9

// Moving values through calls and closures (3.29, 3.30): an `own` parameter
// can be returned or stored, a closure owns what it captures and hands out
// clones, and a nested closure gets its own copy.
struct Greeter(greeting: String) {
    fun greet(name: String) {
        print(greeting)
        print(name)
    }
}

fun pass(s: own String): String = s

fun keeper(word: own String): fun() -> String = { -> word.clone() }

fun repeater(word: own String): fun(Int) -> fun() -> Int = { times ->
    let copy = word.clone()
    { ->
        var i = 0
        while i < times {
            print(copy)
            i += 1
        }
        times
    }
}

fun main(): Int {
    let hello = pass("hello")
    let greeter = Greeter(hello)      // hello moves into the struct
    greeter.greet("world")
    let get = keeper("kept")
    print(get())
    print(get())                      // each call returns a fresh clone
    let echo = repeater("echo")(3)
    let name = "Ada"
    let other = Greeter(greeter.greeting.clone())
    other.greet(name)
    print(name)
    return echo()
}

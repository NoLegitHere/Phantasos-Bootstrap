// A field assignment rebuilds each enclosing struct with `with`, from the
// outside in; compound assignment reads the field first.

struct Point(var x: Int, var y: Int)
struct Line(var from: Point, var to: Point)

fun main(): Int {
    var line = Line(from: Point(x: 0, y: 0), to: Point(x: 1, y: 1))
    line.to.y = 5
    line.from.x += 2
    (line).from = Point(x: 3, y: 4)
    return line.to.y - line.from.x
}

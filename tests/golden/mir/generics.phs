// Generic functions: one instance per distinct list of type arguments, named
// after its arguments, including an instance that only another instance
// needs and a closure inside an instance.

fun identity<T>(x: T): T = x

fun swap<A, B>(p: (A, B)): (B, A) = (p.1, p.0)

fun twice<T>(x: T): (T, T) = (identity(x), x)

fun keep<T>(x: T): T {
    let c = (x, 1)
    let f = { -> c.0 }
    return f()
}

fun main(): Int {
    let a = identity(1)
    let b = identity<Int>(2)
    let p = swap((true, a + b))
    let q = twice(p)
    if keep(q.0.1) { return 1 }
    return q.1.0
}

// Struct arguments and results (abi.md A.6): up to two words travel in
// registers, or on the stack whole once registers run out; larger structs
// travel by address, and a larger result comes back through a hidden pointer.

struct Word(a: Int32, b: Bool)
struct Two(x: Int, y: Int)
struct Odd(x: Int, tag: UInt8)
struct Big(a: Int, b: Int, c: Int, d: Int16)
struct Text(label: String, next: String)

fun flip(t: Two): Two = Two(x: t.y, y: t.x)

fun odd(n: Int): Odd = Odd(x: n * 2, tag: 7)

fun grow(b: Big, by: Int): Big = Big(a: b.a + by, b: b.b + by, c: b.c + by, d: b.d)

fun swap(t: Text): Text = Text(label: t.next.clone(), next: t.label.clone())

// Two registers are left for t after five words, so it goes on the stack and
// the next word still takes the sixth register.
fun spill(a: Int, b: Int, c: Int, d: Int, e: Int, t: Two, f: Int): Int = a + b + c + d + e + t.x * 10 + t.y * 100 + f

// Big's address takes a register while one lasts, then a stack word.
fun far(a: Int, b: Int, c: Int, d: Int, w: Word, x: Big, y: Big): Int = a + b + c + d + Int(w.a) + x.c + y.a

// A large result through recursion keeps every hidden pointer straight.
fun countdown(n: Int, b: Big): Big {
    if n == 0 { return b }
    return countdown(n - 1, grow(b, 1))
}

fun main(): Int {
    let t = flip(Two(x: 1, y: 2))
    print(t.x * 10 + t.y)
    let o = odd(21)
    print(o.x + Int(o.tag))
    let b = grow(Big(a: 1, b: 2, c: 3, d: -4), 10)
    print(b.a + b.b + b.c + Int(b.d))
    let s = swap(Text(label: "first", next: "second"))
    print(s.label)
    print(s.next)
    print(spill(1, 2, 3, 4, 5, Two(x: 6, y: 7), 8))
    print(far(1, 1, 1, 1, Word(a: 2, b: true), b, Big(a: 100, b: 0, c: 0, d: 0)))
    let c = countdown(50, b)
    print(c.a)
    return c.c - c.b   // 63 - 62
}

let values: [Int] = [true]
let index = [1][false]
class A {}
class B {}
let nominal: A = B()
struct Point(x: Int8) {}
let missing = Point()
let range = Point(128)
abstract class Abstract {}
let abstractValue = Abstract()
extern "C" { fun produce(): fun(Int8) -> Bool }
let callback = produce()
let argument = callback(true)
let nestedEmptyFirst = [[], [1, true]]
let nestedEmptyLast = [[1, true], []]
extern "C" { fun produceRequired(): fun(Int) -> Int }
let unsafeVariance: fun(Int?) -> Int = produceRequired()
let badEquality = [1, true] == [true]
let badInequality = [true] != ([[], [1, true]])

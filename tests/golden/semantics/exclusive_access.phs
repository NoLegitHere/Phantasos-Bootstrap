// Exclusive access (E0506): while a call runs, an `inout` argument and the
// receiver of a `mut fun` are the only way to reach their place, so no other
// argument or receiver of the same call may name an overlapping place.

struct Point(var x: Int, var y: Int) {
    mut fun shift(by: Int) { x += by }
    fun copyTo(n: inout Int) { n = x }
    mut fun again() { shift(x) }
}

fun swap(a: inout Int, b: inout Int) {
    let t = a
    a = b
    b = t
}
fun store(p: inout Point, value: Int) { p.x = value }

fun separate() {
    var a = 1
    var b = 2
    swap(a, b)
    var p = Point(x: 1, y: 2)
    swap(p.x, p.y)
    p.shift(a)
    let x = p.x
    p.shift(x)
}
fun overlapping(list: inout [Int]) {
    var a = 1
    swap(a, a)
    var p = Point(x: 1, y: 2)
    store(p, p.x)
    p.shift(p.y)
    p.copyTo(p.x)
    var t = (1, 2)
    swap(t.0, t.0)
    swap(list[0], list[1])
}

var counter: Int = 0
class Registry {
    class Slot { static var used: Int = 0 }
    var size: Int = 0
    mut fun grow(by: Int) { size += by }
    deinit { grow(size) }
}
fun record(a: inout Int, total: inout Int = counter) {}
fun defaults() {
    record(counter)
    swap(Registry.Slot.used, Registry.Slot.used)
}

// Closures are accepted; their parameters and bodies are checked like a
// function's, and their function types like any other.

fun main(): Int {
    let k = { -> 42 }
    let shifted = { x: Int -> x << 1 }
    let half = { -> 1.5 }
    let unit = { u: Unit -> 1 }
    return k()
}

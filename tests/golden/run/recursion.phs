// Deep and mutual recursion.

fun ackermann(m: Int, n: Int): Int {
    if m == 0 { return n + 1 }
    if n == 0 { return ackermann(m - 1, 1) }
    return ackermann(m - 1, ackermann(m, n - 1))
}

fun isEven(n: Int): Bool {
    if n == 0 { return true }
    return isOdd(n - 1)
}

fun isOdd(n: Int): Bool {
    if n == 0 { return false }
    return isEven(n - 1)
}

fun main(): Int {
    var result = ackermann(2, 3)   // 9
    if isEven(5000) { result += 10 }
    if isOdd(5000) { result += 100 }
    return result                  // 19
}

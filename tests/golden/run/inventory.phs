// Ownership in a small inventory (3.30, 3.31): names move into items, a
// clone keeps a copy that is still usable, and `mut fun` updates stock in
// place on separate items.
struct Item(name: String, var count: Int) {
    mut fun add(n: Int) { count += n }
    mut fun take(n: Int): Int {
        if n > count {
            let all = count
            count = 0
            return all
        }
        count -= n
        return n
    }
    fun show() {
        print(name)
        print(count)
    }
}

fun stock(name: own String, count: Int): Item = Item(name, count)

fun rename(item: own Item, name: own String): Item = Item(name, item.count)

fun main(): Int {
    let label = "bolts"
    var bolts = stock(label.clone(), 10)
    print(label)                      // the clone moved; label is still ours
    var nuts = stock("nuts", 4)
    nuts.add(bolts.take(3))           // separate places: no overlap
    bolts.show()                      // bolts 7
    nuts.show()                       // nuts 7
    let spare = nuts.clone()
    let washers = rename(nuts, "washers")
    washers.show()                    // washers 7
    spare.show()                      // nuts 7
    var crate = (bolts, 1)
    crate.0.add(crate.1)
    return crate.0.count + washers.count + spare.count  // 8 + 7 + 7
}

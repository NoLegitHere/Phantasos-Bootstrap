let small: Int8 = -128
let widened = Int64(small)
let unsigned: UInt8 = 255
let changedSign = Int16(unsigned)
let literal = Int8(-128)
let maximum = UInt64(18446744073709551615)
let checked = Int8.checked(widened)
let truncated = Int8.truncating(maximum)
let optional: Int8? = checked
let lifted: Int8? = small
let unwrapped = checked!
fun preserve(value: Int8?): Int8? = value
let returned = preserve(checked)
let fraction: Float32 = 1.0
let floatWidening = Float64(fraction)
fun optionalUnit(): Unit? { return }
fun explicitUnit(): Unit? { return () }

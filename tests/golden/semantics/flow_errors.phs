fun fallsOff(a: Int): Int {
    if a > 0 { return 1 }
}

fun chain(a: Int): Int {
    if a > 1 { return 1 } else if a > 0 { return 2 }
}

fun whileOnly(c: Bool): Int {
    while c { return 1 }
}

fun breaks(): Int {
    loop { break }
}

fun partial(c: Bool): Int {
    var y: Int
    if c { y = 1 }
    return y
}

fun looped(c: Bool): Int {
    var y: Int
    while c { y = 1 }
    return y
}

fun compound(): Int {
    var y: Int
    y += 1
    return 0
}

let limit = 1

fun parameter(x: Int) { x = 1 }

fun local() {
    let x = 1
    x = 2
}

fun twice() {
    let y: Int
    y = 1
    y = 2
}

fun repeated(c: Bool) {
    let y: Int
    while c { y = 1 }
}

fun global() { limit = 2 }

fun bound(values: [Int]) {
    for v in values { v = 1 }
}

fun caught(): Int {
    let x = try? unsafe { throw 1 }
}

fun guarded(v: Int) {
    let x: Int
    match v {
        _ if unsafe { x = 1
            false } -> {}
        _ -> { x = 2 }
    }
}

fun condition(c: Bool) {
    let x: Int
    while unsafe { x = 1
        c } {}
}

fun maybe(): Never? = none

fun optionalNever(): Int {
    maybe()
}

fun cleanupThenWrite() {
    let x: Int
    defer { x = 1 }
    x = 2
}

fun defaulted(value: Int = unsafe { var x: Int
    x }) {}

fun rewritesParam(a: Int, b: Int = unsafe { a = 1
    0 }) {}

open class Base(x: Int) {}

class Derived: Base(unsafe { var x: Int
    x }) {}

class Field(a: Int) {
    let b: Int = unsafe { a = 1
        0 }
}

struct Taker(let n: Int) {
    fun take(k: Int): Int = k
}

fun chainedArgument(p: Taker?): Int {
    var x: Int
    let r = p?.take(if true { x = 1
        0 } else { x = 2
        0 })
    return x
}

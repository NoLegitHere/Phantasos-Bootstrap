// Brace closures: parameters with optional types, '->', then statements
// whose last expression is the result.

fun main() {
    let double = { x -> x * 2 }
    let add = { a: Int, b: Int -> a + b }
    let answer = { -> 42 }
    let trailing = { x, y, -> x }
    let steps = { n: Int ->
        let twice = n * 2
        twice + 1
    }
    let curried = { x -> { y -> x + y } }
    let called = { x -> x }(1)
    apply({ x -> x + 1 }, 2)
    let typed = { f: fun(Int) -> Int, x -> f(x) }
}

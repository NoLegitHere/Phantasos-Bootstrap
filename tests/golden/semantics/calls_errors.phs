fun scalar(value: Int): Int = value
let wrongType = scalar(true)
let missing = scalar()
let extra = scalar(1, 2)
let label = scalar(missing: 1)
fun dual(value: Int8): Int8 = value
fun dual(value: UInt8): UInt8 = value
let ambiguous = dual(1)
fun narrow(value: Int8): Int8 = value
let outside = narrow(128)
let notCallable = 1()
fun inferred() = 1
let mismatch: Bool = inferred()
fun cycleRoot() = cycleOverload(1)
fun cycleOverload(value: Bool) = cycleRoot()
fun cycleOverload(value: Int) = 1
let first = cycleRoot()
let badCycleResult: Bool = cycleOverload(true)

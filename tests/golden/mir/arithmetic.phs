// Operators, wrapping arithmetic, conversions and negative literals.

fun ops(a: Int32, b: Int32): Int32 {
    var r = a * b - a / b + a % b
    r &= 255
    r |= 1
    r ^= ~b
    return r &+ a &- b &* 2
}

fun compare(a: UInt8, b: UInt8): Bool = a < b || a >= b && a != b || !(a == b) && a <= b && a > b

fun main(): Int {
    let min: Int64 = -9223372036854775808
    let small: Int8 = Int8.truncating(300)
    let wide = Int64(ops(-3, 2))
    if compare(1, 2) { return Int(small) }
    return Int(wide + min - min)
}

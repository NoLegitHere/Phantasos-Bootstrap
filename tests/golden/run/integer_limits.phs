// Integer formatting at the edges of each type, and Bool.

fun main(): Int {
    let largest: Int = 9223372036854775807
    print(largest)
    print(-largest - 1)
    print(0)
    print(-1)
    let top: UInt = 18446744073709551615
    print(top)
    let zero: UInt = 0
    print(zero)
    print(true)
    print(1 > 2)
    return 3
}

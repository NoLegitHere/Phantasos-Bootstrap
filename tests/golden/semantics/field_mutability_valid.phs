// Writes through mutable places: 'var' fields of 'var' locals, 'inout' and
// 'own' parameters, 'self' in a 'mut fun' or an 'init', class objects through
// owning references, and static 'var' fields.

struct Inner(var n: Int) {
    mut fun bump() { n += 1 }
}
struct Outer(var inner: Inner, let fixed: Inner) {
    var count: Int = 0
    static var total: Int = 0
    init(n: Int) {
        inner = Inner(n)
        fixed = Inner(n)
    }
    mut fun step() {
        inner.bump()
        self.inner.n = 2
        count += 1
        bump2()
        total += 1
        self = Outer(n: 1)
    }
    mut fun bump2() { inner.n -= 1 }
    fun read(): Int = inner.n + count
}
class Box(var value: Int) {
    let size: Int = 1
    mut fun grow() { value += 1 }
    fun peek(): Int = value
}
fun own_box(b: own Box) { b.value = 1; b.grow() }
fun take(o: inout Outer) { o.inner.n = 3; o.step(); o.inner.bump() }
fun main() {
    var o = Outer(n: 1)
    o.inner.n = 4
    o.count += 2
    o.step()
    o.inner.bump()
    take(o: o)
    let b = Box(1)
    b.value = 2
    b.grow()
    Box(3).grow()
    Box(3).value = 4
    Outer.total = 5
    var s = shared Box(1)
    s.grow()
}

// Interfaces the gate accepts as bounds, and the interface features it does
// not yet: generic interfaces, interfaces that extend others, static
// requirements, 'where' clauses and values of an interface type.

interface Shape {
    fun area(): Int
    fun twice(): Int = area() * 2
}

struct Square(side: Int): Shape {
    fun area(): Int = side * side
}

fun accepted<T: Shape>(x: T): Int = x.twice()

interface Holder<T> {
    fun held(): T
}

interface Solid: Shape {
    fun volume(): Int
}

interface Factory {
    static fun make(): Int
}

struct Cube(side: Int): Solid {
    fun area(): Int = side * side
    fun volume(): Int = side * side * side
}

fun held<T: Holder<Int>>(h: T): Int = h.held()

fun constrained<T>(x: T): Int where T: Shape = x.area()

fun value(): Int {
    let s: Shape = Square(side: 2)
    return s.area()
}

fun main(): Int = accepted(Square(side: 1))

class Known { class Nested {} }
fun forward() = missing()
let bad: Unknown = none
let nested: Known.Absent = none
fun locals() {
    later
    let later = 1
    let ownValue = ownValue
    if let x = 1 { x } else { x }
    for y in [1] { y }
    y
}
fun defaults(a: Int = b, b: Int = 1) = a
fun generic<T>(x: T) = x
let escaped: T = none
fun outside() = self

// `with` updates a struct in its slots: a narrow field is stored at its own
// size, a nested struct is copied in.

struct Flags(var on: Bool, var level: Int16)
struct Pair(var left: Flags, var right: Flags)

fun main(): Int {
    var pair = Pair(left: Flags(on: false, level: 1), right: Flags(on: true, level: 2))
    pair.left.level = -3
    pair.right = pair.left
    return Int(pair.right.level)
}

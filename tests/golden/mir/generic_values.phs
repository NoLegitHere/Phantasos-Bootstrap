// Generic functions as values: each one refers to the instance for the type
// arguments the checker inferred or that were written out, the same
// instance a call with those arguments uses.

fun identity<T>(x: T): T = x

fun map<T, U>(x: T, f: fun(T) -> U): U = f(x)

fun main(): Int {
    let f: fun(Int) -> Int = identity
    let g = identity<Bool>
    if g(true) { return map(f(1), { x -> x + identity(1) }) }
    return 0
}

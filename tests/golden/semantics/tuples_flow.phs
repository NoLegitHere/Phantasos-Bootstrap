// Tuples are values: an element is as mutable as the place holding the
// tuple, and destructured names follow 'let' or 'var'.
struct P(var x: Int)
class C(var x: Int)

fun main() {
    let t = (1, 2)
    t.0 = 4
    let (k, l) = t
    k = 3
    var (u, v) = t
    u = l
    v += 1
    let s = (P(x: 1), C(x: 2))
    s.0.x = 1
    s.1.x = 2
    (1, 2).0 = 3
}

fun read(p: (Int, Int)) {
    p.1 = 0
}

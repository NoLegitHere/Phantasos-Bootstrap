// A leaderboard over any type that can be ranked: an interface with a default
// method, generic functions bounded by it, and a generic struct that keeps the
// top three of whatever it ranks.

interface Ranked {
    fun score(): Int
    fun label(): String
    fun beats(other: Self): Bool = score() > other.score()
}

struct Player(name: String, points: Int): Ranked {
    fun score(): Int = points
    fun label(): String = name.clone()
}

struct Team(name: String, wins: Int, draws: Int): Ranked {
    fun score(): Int = wins * 3 + draws
    fun label(): String = name.clone()
}

struct Podium<T: Ranked>(first: T, second: T, third: T) {
    // Places a newcomer, pushing the others down.
    fun with(entry: T): Podium<T> {
        if entry.beats(first) { return Podium(first: entry, second: first, third: second) }
        if entry.beats(second) { return Podium(first: first, second: entry, third: second) }
        if entry.beats(third) { return Podium(first: first, second: second, third: entry) }
        return self
    }
    fun show() {
        print(first.label())
        print(second.label())
        print(third.label())
    }
    fun total(): Int = first.score() + second.score() + third.score()
    fun sorted(): Podium<T> {
        var p = self
        if p.second.beats(p.first) { p = Podium(first: p.second, second: p.first, third: p.third) }
        if p.third.beats(p.second) { p = Podium(first: p.first, second: p.third, third: p.second) }
        if p.second.beats(p.first) { p = Podium(first: p.second, second: p.first, third: p.third) }
        return p
    }
}

fun start<T: Ranked>(a: T, b: T, c: T): Podium<T> = Podium(first: a, second: b, third: c).sorted()

fun best<T: Ranked>(a: T, b: T): T {
    if b.beats(a) { return b }
    return a
}

fun main(): Int {
    let players = start(Player(name: "ada", points: 7), Player(name: "bo", points: 9), Player(name: "cy", points: 3))
        .with(Player(name: "di", points: 8))
    players.show()
    let teams = start(Team(name: "reds", wins: 2, draws: 1), Team(name: "blues", wins: 1, draws: 4),
                      Team(name: "greens", wins: 3, draws: 0))
    teams.show()
    print(best(Player(name: "ed", points: 5), Player(name: "flo", points: 6)).label())
    return players.total() + teams.total()
}

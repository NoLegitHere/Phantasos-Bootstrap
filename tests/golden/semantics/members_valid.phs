struct Point(var x: Int8) {
    fun read() = self.x
    fun forward() = read()
    static fun make(value: Int8 = 1): Point = Point(value)
}
type Position = Point
let point = Position.make(value: 3)
let field: Int8 = point.x
let method: Int8 = point.forward()
fun write(value: inout Point) { value.x = 1 }
class Namespace { static let flag: Bool = true; class Nested(let value: Int) {} }
type Alias = Namespace
let flag: Bool = Alias.flag
let nested: Int = Alias.Nested(1).value
open class Base { let value: Int = 1 }
class Derived: Base {}
let pending = Derived().value

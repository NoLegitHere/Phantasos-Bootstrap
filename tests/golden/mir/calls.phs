// Calls: labels pass in parameter order, overloads get unique names, and a
// call to a Never function ends its block.

fun sub(a: Int, b: Int): Int = a - b

fun sub(a: Int8): Int8 = a

fun stop(): Never {
    loop {}
}

fun noop() {}

fun main() {
    noop()
    let x: Int = if sub(b: 1, a: 5) > 0 { sub(2, 1) } else { stop() }
    let y: Int8 = sub(Int8.truncating(x))
    if y == 0 { return }
}

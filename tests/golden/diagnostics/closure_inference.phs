// A closure parameter without an annotation takes its type from the function
// type the closure is expected to have (3.29).

fun over(f: fun(Int) -> Int): Int = 1
fun over(f: fun(Bool) -> Int): Int = 2
fun generic<T>(f: fun(T) -> T): Int = 0
fun take(f: fun(Int) -> Int): Int = f(1)

fun main() {
    let alone = { x -> x }
    let overloaded = over({ x -> 1 })
    let viaGeneric = generic({ x -> x })
    let notFunction: Int = { -> 1 }
    let arity: fun(Int) -> Int = { x, y -> x }
    let annotated: fun(Int) -> Int = { x: Bool -> 1 }
    let result = take({ x -> true })
    let mixed = { x: Int ->
        if x > 0 {
            return true
        }
        1
    }
    let unit: fun() -> Unit = { -> 5 }
}

// Closures take parameter types from annotations or from the function type
// they are expected to have, and capture outer values by copy (3.29).

fun apply(f: fun(Int) -> Int, x: Int): Int = f(x)

fun makeAdder(n: Int): fun(Int) -> Int = { x -> x + n }

fun makeGreeting(name: own String): fun() -> String = { -> name.clone() }

struct Handler(run: fun(Int) -> Int)

struct Counter(var count: Int) {
    fun reader(): fun() -> Int = { -> count + self.count }
}

fun choose(useDouble: Bool): fun(Int) -> Int {
    if useDouble {
        return { x -> x * 2 }
    }
    return { x -> x + 1 }
}

fun main(): Int {
    // Annotated parameters need no context; the result comes from the body.
    let double = { x: Int -> x * 2 }
    let zero = { -> 0 }
    // The expected type gives the parameter and result types, so literals take them.
    let wide: fun(Int64, Int64) -> Int64 = { a, b -> a + b + 1 }
    let early: fun(Int) -> Int = { x ->
        if x < 0 {
            return 0
        }
        x
    }
    var current: fun(Int) -> Int = double
    current = { y -> y - 1 }
    let handler = Handler(run: { x -> x * 3 })
    let curried: fun(Int) -> fun(Int) -> Int = { a -> { b -> a + b } }
    let base = 10
    let total = apply({ x -> x + base }, 1) + double(2) + zero() + early(3) + current(4)
    let maybe: (fun(Int) -> Int)? = { x -> x }
    // Captures are copies, so later changes to a 'var' do not reach the closure.
    var seen = 1
    let snapshot = { -> seen }
    seen = 2
    let nested = { -> { -> base + seen } }
    let parenthesized: fun(Int) -> Int = ({ x -> x })
    return total + handler.run(1) + curried(1)(2) + makeAdder(5)(1) + snapshot() + nested()() + parenthesized(0) +
        Counter(count: 3).reader()() + choose(true)(4) + Int(wide(1, 2))
}

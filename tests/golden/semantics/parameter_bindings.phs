class Good(let x: Int, var y: Int) { init(z: Int) {} }
struct Value(let x: Int, var y: Int, z: Int) {}
actor Worker(let x: Int, var y: Int) {}
fun ordinary(x: borrow Int, y: inout Int, z: own Int) {}
fun invalid(let /* not a field */ x: Int, var y: Int = 0) {}
extern "C" { fun foreign(let x: Int) }
class Bad {
    fun method(var x: Int) {}
    init(let x: Int, var y: Int) {}
}
interface I { fun required(let x: Int) }

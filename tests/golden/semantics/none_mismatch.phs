// print accepts exactly the four prelude overloads; narrow integers and
// none only fits an optional type (3.6). Against a concrete non-optional
// type it is a mismatch; optional and generic contexts stay deferred.

fun take(x: Int) {}
fun maybe(x: Int?) {}
fun pick(x: Int) {}
fun pick(x: String) {}
fun same<T>(x: T): T = x

fun number(): Int = none

fun early(): Bool {
    return none
}

fun main() {
    take(none)
    take((none))
    pick(none)
    maybe(none)
    let a: Int = none
    let b: Int? = none
    let c: Bool = if b == none { none } else { false }
    let d: [Int] = [1, none]
    var e = 1
    e = none
    let f: Int? = same(none)
}

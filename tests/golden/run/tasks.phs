// A small task list: an array of structs that grows with `append`, optional
// fields read with `if let`, `??` and `?.`, a lookup that returns `none` when
// nothing matches, and a cloned array that changes on its own.

struct Task(id: Int, title: String, var done: Bool, owner: String?) {
    fun show() {
        let mark: String = if done { "[x] " } else { "[ ] " }
        print(mark)
        print(title)
        print(owner ?? "nobody")
    }
}

struct Board(var tasks: [Task]) {
    mut fun add(title: own String, owner: own String?) { tasks.append(Task(tasks.count + 1, title, false, owner)) }
    mut fun finish(at: Int) { tasks[at].done = true }
    fun find(id: Int): Int? {
        var i = 0
        while i < tasks.count {
            if tasks[i].id == id { return i }
            i += 1
        }
        return none
    }
    fun remaining(): Int {
        var n = 0
        for task in tasks {
            if !task.done { n += 1 }
        }
        return n
    }
    fun last(): Task? {
        if tasks.isEmpty { return none }
        return tasks[tasks.count - 1].clone()
    }
}

fun main(): Int {
    var board = Board([])
    board.add("write spec", "ada")
    board.add("fix parser", none)
    board.add("ship stage0", "bo")
    if let at = board.find(2) { board.finish(at) }
    let missing = board.find(9) ?? -1
    print(missing)
    for task in board.tasks { task.show() }
    print(board.last()?.title ?? "empty")
    var done = board.tasks.clone()
    let dropped = done.removeLast()
    print(dropped?.owner ?? "none")
    print(done.count)
    return board.remaining() * 10 + board.tasks.count  // 23
}

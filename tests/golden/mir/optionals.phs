// Optionals: the layout, none, if let, ??, equality, and values lifted where
// an optional is expected.

fun find(n: Int): Int? {
    if n < 0 { return none }
    return n
}

fun main(): Int {
    var total = 0
    if let v = find(2) { total += v }
    let same = find(1) == 1
    let deep: Int? ? = find(3)
    if same && deep != none { total += (deep ?? none) ?? 0 }
    return total
}

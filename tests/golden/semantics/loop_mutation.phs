// A `for` loop over an array (3.33) has exclusive access to the place it
// runs over: the body may read it, but not assign to it, change it, pass it
// `inout` or move it (E0506). Other places, and loops over a clone, are fine.

struct Holder(var xs: [Int], var count: Int)
struct Walker(var xs: [Int]) {
    mut fun clear() { xs = [] }
    mut fun walk() {
        for x in xs { clear() }
        for x in xs { print(x) }
    }
}

fun take(xs: own [Int]) {}
fun reset(xs: inout [Int]) { xs = [] }

fun changes() {
    var a = [1, 2]
    for x in a { a.append(x) }
    for x in a { a[0] = 3 }
    for x in a { a = [] }
    for x in a { reset(a) }
    for x in a { take(a) }
    var h = Holder([1], 0)
    for x in h.xs { h.xs.append(1) }
    for x in h.xs { h = Holder([], 0) }
    var g = [[1]]
    for x in g[0] { g[0].append(2) }
    for x in g[0] { g[1] = [] }
}

fun allowed() {
    var a = [1, 2]
    var total = 0
    for x in a { total += a[0] + a.count }
    for x in a.clone() { a.append(x) }
    for x in [1, 2] { a.append(x) }
    for i in 0..<a.count { a.append(i) }
    var h = Holder([1], 0)
    for x in h.xs { h.count += x }
}

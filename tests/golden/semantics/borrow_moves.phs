// Moving out of a borrow (E0505): only a local or an `own` parameter can
// move. Borrowed and `inout` parameters, `self`, fields, elements and the
// captures of a closure stay where they are; `.clone()` moves a copy.

struct Name(text: String, n: Int) {
    fun label(): String = text
    fun whole(): Name = self
    fun copied(): String = text.clone()
}

fun take(s: own String) {}

fun parameters(a: String, b: inout String, c: own String) {
    take(a)
    let x = b
    take(c)
    take(a.clone())
}
fun parts(name: Name, pair: (Int, String), list: [String], maybe: String?, named: Name?) {
    let n = name.n
    let t = name.text
    let s = pair.1
    let e = list[0]
    let m = maybe!
    let c = named?.text
    let k = named?.n
}
fun owned() {
    let name = Name("x", 1)
    let t = name.text
    let whole = name
}
fun closures(s: own String) {
    let again = { -> s }
    let copy = { x: String -> x.clone() }
    let moved = { x: String -> x }
}
fun nested(s: own String) {
    let outer = { -> { -> s.clone() } }
}
fun fixed(s: own String) {
    let fixed = { -> let c = s.clone()
        { -> c.clone() } }
}
open class Base(var n: Int) {}
class Derived(): Base(1) {
    static let tag: String = "d"
    fun leak(): Base = super
    static fun qualified(): String = Derived.tag
    static fun bare(): String = tag
}
fun unreachable(s: String) {
    return
    take(s)
}

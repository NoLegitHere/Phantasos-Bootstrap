// Interfaces as bounds: a call on a bounded value goes straight to the
// conforming struct's method, and a default body becomes one function per
// conforming struct, named after the interface and that struct.

interface Shape {
    fun area(): Int
    fun twice(): Int = area() * 2
}

struct Square(side: Int): Shape {
    fun area(): Int = side * side
}

fun measure<T: Shape>(x: T): Int = x.area() + x.twice()

fun main(): Int = measure(Square(side: 3))

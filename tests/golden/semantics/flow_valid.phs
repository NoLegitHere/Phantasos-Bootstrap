// Every path returns or diverges, and locals are initialized before use.
fun sign(x: Int): Int {
    if x > 0 { return 1 } else if x < 0 { return -1 } else { return 0 }
}

fun forever(): Int {
    loop {}
}

fun firstAbove(limit: Int): Int {
    var i = 0
    loop {
        if i > limit { return i }
        i += 1
    }
}

fun checked(x: Int): Int {
    if x >= 0 { return x }
    panic("negative")
}

fun later(x: Int): Int {
    let y: Int
    if x > 0 { y = 1 } else { y = 2 }
    return y
}

fun sumTo(limit: Int): Int {
    var total: Int
    total = 0
    var i = 1
    while i <= limit {
        if i % 3 == 0 || i % 5 == 0 { total += i }
        i += 1
    }
    return total
}

fun classify(x: Int): Int {
    var y: Int
    match x {
        0 -> { y = 10 }
        _ -> { y = 20 }
    }
    return y
}

fun aborts(): Int {
    let unused = try? panic("stop")
}

fun catchAll(v: Int): Int {
    var x: Int
    match v {
        _ -> { x = 1 }
        0 -> {}
    }
    return x
}

fun guardFirst(v: Int): Int {
    var x: Int
    match v {
        _ if unsafe { x = 1
            false } -> {}
        _ -> {}
    }
    return x
}

fun reset(x: inout Int) { x = 0 }

var counter = 0
fun bump() { counter += 1 }

// Branch results take their context, and an optional context allows a missing else.
fun larger(a: Int, b: Int): Int = if a > b { a } else { b }
fun pick(flag: Bool): UInt8 = if flag { 255 } else if !flag { 1 } else { 0 }
fun present(flag: Bool): Int? = if flag { 5 }
let wide: Int64 = if true { 1 } else { 2 }
let missing: Int? = if false { 1 } else { none }

fun main(): Int {
    return sumTo(9) + larger(1, 2)
}

// Closures capture copies, which are read-only. Borrowed parameters can only
// be captured when their type is Copy, and 'inout' parameters never (3.29).

struct Point(var x: Int)

class Account(var balance: Int) {
    fun reader(): fun() -> Int = { -> balance }
}

struct Meter(var value: Int) {
    mut fun reader(): fun() -> Int = { -> self.value }
}

fun capture(n: inout Int, text: String, owned: own String, k: Int): Int {
    var count = 0
    let point = Point(x: 1)
    let later: Int
    let a = { -> n }
    let b = { -> text.clone() }
    let c = { -> owned.clone() }
    let d = { -> k + later }
    let e: fun() -> Unit = { -> count = 1 }
    let f: fun() -> Unit = { -> point.x = 2 }
    let g: fun(Int) -> Unit = { y -> y = 3 }
    let h = { -> { -> count += 1 } }
    later = 1
    return 0
}

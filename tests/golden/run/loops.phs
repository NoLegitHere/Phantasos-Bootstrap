// Nested loops with break and continue: there are 25 primes below 100.

fun isPrime(n: Int): Bool {
    if n < 2 { return false }
    var d = 2
    while d * d <= n {
        if n % d == 0 { return false }
        d += 1
    }
    return true
}

fun main(): Int {
    var count = 0
    var n = 0
    loop {
        n += 1
        if n >= 100 { break }
        if !isPrime(n) { continue }
        count += 1
    }
    return count
}

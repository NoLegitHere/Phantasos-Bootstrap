// Optionals (3.6): `if let` and `while let` bind the value inside, `??`
// falls back, and `==` compares with `none`. Only optionals unwrap.

fun find(n: Int): Int? {
    if n == 0 { return none }
    return n
}

fun valid(n: Int): Int {
    var total = 0
    if let found = find(n) { total += found }
    while let next = find(total) { total = next - 1 }
    if find(n) == none { total += 1 }
    return total + (find(n) ?? 0)
}

fun errors(n: Int) {
    if let x = n {}
    if let y = none {}
    let z = n ?? 1
    let w = none ?? 1
    let v = find(n) ?? "zero"
}

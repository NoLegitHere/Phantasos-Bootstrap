type Number = Int
enum E { A(Int), B(Int), Empty }
let failure = 1
let items = [1, 2]
fun cleanup() {}
async fun task() {}
interface Sequence { type Element; type Index = Int }
class Counter<T>(let value: T) {
    init { return }
    init(value: T) throws(Error) { throw failure }
    deinit { cleanup() }
    fun read(value: T) {
        let value = 1
        if true { let value = 2 }
        while true { for item in items { continue }; break }
        loop { break }
    }
}
async fun run() throws(Error) { await task(); throw failure }
fun inspect(value: E) = match value {
    .A(x) | .B(x) -> x
    .Empty -> 0
}
fun optionalError() = try? unsafe { throw failure }

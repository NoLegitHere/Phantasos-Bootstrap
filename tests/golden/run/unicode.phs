// Strings are UTF-8 bytes and print writes them unchanged, escapes included.

fun main() {
    print("héllo wörld")
    print("\u{1F30D} \u{3053}\u{3093}\u{306B}\u{3061}\u{306F}")
    print("tab\there")
    print("")
}

// A 2D vector with methods, and a rectangle of two vectors. Vec fits in two
// registers; Rect is 32 bytes, so it is passed by address and comes back
// through a hidden pointer.

struct Vec(x: Int, y: Int) {
    fun plus(other: Vec): Vec = Vec(x: x + other.x, y: y + other.y)
    fun scaled(by: Int): Vec = Vec(x: x * by, y: y * by)
    fun dot(other: Vec): Int = x * other.x + y * other.y
    fun lengthSquared(): Int = dot(self)
}

struct Rect(min: Vec, max: Vec) {
    fun width(): Int = max.x - min.x
    fun height(): Int = max.y - min.y
    fun area(): Int = width() * height()
    fun moved(by: Vec): Rect = Rect(min: min.plus(by), max: max.plus(by))
    fun contains(p: Vec): Bool = p.x >= min.x && p.x < max.x && p.y >= min.y && p.y < max.y
}

fun grow(r: Rect, by: Int): Rect {
    let corner = Vec(x: by, y: by)
    return Rect(min: r.min.plus(corner.scaled(-1)), max: r.max.plus(corner))
}

fun main(): Int {
    let a = Vec(x: 3, y: 4)
    let b = Vec(x: -1, y: 2)
    print(a.lengthSquared())
    print(a.dot(b))
    let c = a.plus(b).scaled(2)
    print(c.x)
    print(c.y)
    var r = Rect(min: Vec(x: 0, y: 0), max: Vec(x: 4, y: 3))
    print(r.area())
    r = grow(r.moved(Vec(x: 10, y: 10)), 1)
    print(r.min.x)
    print(r.max.y)
    print(r.area())
    print(r.contains(Vec(x: 9, y: 9)))
    print(r.contains(Vec(x: 15, y: 9)))
    return r.width()
}

// Polymorphic recursion: each instance of grow calls one with a bigger
// type argument, so monomorphization would never end (E0602).

fun grow<T>(x: T, n: Int): Int {
    if n == 0 { return 0 }
    return grow((x, x), n - 1)
}

fun main(): Int = grow(1, 3)

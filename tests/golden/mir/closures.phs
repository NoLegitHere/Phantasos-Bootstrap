// Closures: each becomes a function that takes its environment first. The
// environment holds a copy of every captured value, the receiver included, and
// the body reads them on entry. Nested closures capture through the closures
// around them; a closure that captures nothing has no environment.

struct Point(x: Int, y: Int) {
    fun shifter(): fun(Int) -> Point = { by -> Point(x: x + by, y: self.y) }
}

fun makeAdder(n: Int): fun(Int) -> Int = { x -> x + n }

fun main(): Int {
    let twice = { x: Int -> x * 2 }
    let label = "sum"
    let sum = { a: Int ->
        let copy = label.clone()
        { b: Int ->
            print(copy)
            a + b
        }
    }
    let moved = Point(x: 1, y: 2).shifter()(3)
    return twice(makeAdder(1)(2)) + sum(3)(4) + moved.x
}

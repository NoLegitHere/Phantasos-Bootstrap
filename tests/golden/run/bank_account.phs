// A bank account whose balance changes through 'mut fun' methods. A failed
// withdrawal leaves the balance alone; overdrawing on purpose traps.

struct Account(owner: String, var balance: UInt, var transactions: Int) {
    mut fun deposit(amount: UInt) {
        balance += amount
        transactions += 1
    }

    mut fun withdraw(amount: UInt): Bool {
        if amount > balance { return false }
        balance -= amount
        transactions += 1
        return true
    }

    fun report() {
        print(owner)
        print(balance)
        print(transactions)
    }
}

fun main() {
    var alice = Account(owner: "alice", balance: 100, transactions: 0)
    var bob = Account(owner: "bob", balance: 0, transactions: 0)
    alice.deposit(50)
    print(alice.withdraw(500))
    if alice.withdraw(120) { bob.deposit(120) }
    print(bob.withdraw(200))
    alice.report()
    bob.report()
    bob.balance -= 121   // traps: UInt underflow
    print("not reached")
}

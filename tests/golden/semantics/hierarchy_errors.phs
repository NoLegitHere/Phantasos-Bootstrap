class Closed {}
class ClosedChild: Closed {}
open class A: B {}
open class B: A {}
open class Virtual { open fun read(): Int = 1 }
class MissingOverride: Virtual { fun read(): Int = 1 }
interface Required { fun get(): Int }
class Missing: Required {}
class Wrong: Required { fun get(): Bool = true }
open class Root {}
class Child: Root {}
let down: Child = Root()
open class Args(x: Int8) {}
class BadArgs: Args(128) {}

class Overloaded {
    fun select(x: Int): Int = x
    fun select<T>(x: T, y: T): T = x
}
let mismatch: Bool = Overloaded().select(1)
let noMatch = Overloaded().select(true)

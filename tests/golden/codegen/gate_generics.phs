// Generic functions and structs the gate accepts, and uses of them it does
// not yet: type arguments outside the subset or without a value, also in
// generic function values, and structs that hold themselves through type
// arguments.

fun identity<T>(x: T): T = x

fun pair<A, B>(a: A, b: B): (A, B) = (a, b)

fun accepted(): (Int, (Bool, String)) = pair(identity(1), pair(true, "s"))

struct Box<T>(value: T) {
    fun same<U>(x: U): (T, U) = (value, x)
}

struct Looped<T>(inner: Box<[Looped<T>]>)

fun boxes(): Int {
    let b = Box(value: 1).same("s")
    let unit = Box(value: ())
    return b.0
}

fun stop(): Never {
    loop {}
}

fun arguments() {
    identity(1.5)
    identity<Int?>(1)
    identity(())
    identity<Never>(stop())
}

fun value(): Int {
    let f: fun(Int) -> Int = identity
    let g = identity<Bool>
    let h: fun(Float64) -> Float64 = identity
    let u = identity<Unit>
    return f(1)
}

fun main(): Int = 0

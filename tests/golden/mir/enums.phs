// An enum's layout has its tag first, then every case's payload fields from
// one offset. A case value is made from its payload, in field order after
// evaluating arguments in source order; `==` compares tags.
enum Tok {
    num(Int)
    pair(b: Bool, a: Int8)
    plus
    word(String)
}

enum Color { red, green }

fun same(a: Color, b: Color): Bool = a == b

fun main(): Int {
    let t: Tok = .pair(a: 1, b: true)
    let w = Tok.word("hi")
    let n = Tok.num(4)
    let p: Tok? = Tok.plus
    if same(.red, Color.green) { return 1 }
    return 0
}

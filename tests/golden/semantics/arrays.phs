// Arrays and flow (3.33): `append` and `removeLast` need a mutable array, a
// `for` binding borrows each element, and `append` moves its argument.

struct Bag(var items: [String])

fun take(s: own String) {}

fun mutability(values: [Int], bag: Bag) {
    let fixed = [1, 2]
    fixed.append(3)
    let last = fixed.removeLast()
    values.append(1)
    bag.items.append("x")
    [1].append(2)
    var owned = Bag([])
    owned.items.append("fine")
    owned.items.count = 0
}

fun chained(maybe: [Int]?, held: inout [Int]?): Int? {
    maybe?.append(1)
    held?.append(1)
    return held?.removeLast() ?? maybe?.count
}

fun elements(words: [String]) {
    for word in words { take(word) }
    for word in words { take(word.clone()) }
    for word in words { word = "x" }
    for word in words { let f = { -> word.clone() } }
    for i in 0..<words.count { take(words[i]) }
}

fun moves() {
    var kept: [String] = []
    let s = "s"
    kept.append(s)
    take(s)
}

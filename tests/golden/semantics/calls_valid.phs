let forward = next(1)
fun next(value: Int) = value + 1
fun defaults(first: Int = 1, second: Int = first): Int = first + second
let named = defaults(second: 2, first: 3)
let omitted = defaults(second: 4)
let parenthesized = (next)(1)
fun overload(value: Int): Int = value
fun overload(value: String): String = value.clone()
let integer = overload(1)
let string = overload("hello")
fun sized(value: Int8): Int8 = value
fun sized(value: UInt64): UInt64 = value
let maximum = sized(18446744073709551615)
let small: Int8 = 1
let typed = sized(small)
extern "C" { fun foreign(value: Float32): Float32 }
let external = foreign(1.0)
fun recursive(value: Int): Int = recursive(value)
let recursiveResult = recursive(1)
fun delayed<T>(value: T): T = value
let pendingGeneric = delayed(1)

// Interfaces as bounds: calls on a bounded value go straight to the
// conforming struct's method, or to the interface's default instantiated
// for that struct, including mutating ones, defaults that call other
// requirements, generic structs that conform, and several bounds at once. A
// plain `fun` can implement a `mut fun` requirement.

interface Shape {
    fun area(): Int
    fun name(): String
    fun describe(): String = name()
    fun larger(other: Self): Bool = area() > other.area()
}

interface Counter {
    mut fun bump()
    fun count(): Int
    mut fun bumpTwice() {
        bump()
        bump()
    }
}

struct Square(side: Int): Shape {
    fun area(): Int = side * side
    fun name(): String = "square"
}

struct Rect(width: Int, height: Int): Shape {
    fun area(): Int = width * height
    fun name(): String = "rect"
    fun describe(): String = "a rectangle"
}

struct Pair<T: Shape>(first: T, second: T): Shape {
    fun area(): Int = first.area() + second.area()
    fun name(): String = "pair"
}

struct Tally(var n: Int): Counter, Shape {
    mut fun bump() { n += 1 }
    fun count(): Int = n
    fun area(): Int = n
    fun name(): String = "tally"
}

struct Fixed(n: Int): Counter {
    fun bump() {}
    fun count(): Int = n
}

fun bumped<T: Counter>(c: T, by: Int): Int {
    var x = c
    x.bumpTwice()
    x.bump()
    return x.count() + by
}

fun largest<T: Shape>(a: T, b: T): T {
    if a.larger(b) { return a }
    return b
}

fun total<T: Shape>(shapes: (T, T, T)): Int = shapes.0.area() + shapes.1.area() + shapes.2.area()

fun tick<T: Counter & Shape>(c: T): Int {
    var x = c
    x.bumpTwice()
    x.bump()
    print(x.describe())
    return x.count() + x.area()
}

fun main(): Int {
    let s = largest(Square(side: 3), Square(side: 2))
    print(s.area())
    print(largest(Rect(width: 2, height: 5), Rect(width: 3, height: 3)).describe())
    print(total((Square(side: 1), Square(side: 2), Square(side: 3))))
    let p = Pair(first: Square(side: 2), second: Square(side: 1))
    print(p.area())
    print(p.describe())
    print(largest(p, Pair(first: Square(side: 1), second: Square(side: 1))).area())
    print(tick(Tally(n: 1)))
    print(bumped(Fixed(n: 4), 1))
    print(bumped(Tally(n: 4), 1))
    var t = Tally(n: 0)
    t.bumpTwice()
    return t.count()
}

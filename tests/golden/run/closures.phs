// Closures outlive the calls that create them: makeAdder's environment is
// still there when the adder runs. Captured values are copies taken when the
// closure is created.

fun makeAdder(n: Int): fun(Int) -> Int = { x -> x + n }

fun applyTwice(f: fun(Int) -> Int, x: Int): Int = f(f(x))

fun main(): Int {
    let add3 = makeAdder(3)
    print(add3(4))
    print(applyTwice(add3, 10))
    var count = 1
    let snapshot = { -> count }
    count = 50
    print(snapshot())
    let word = "hello"
    let greet = { times: Int ->
        let copy = word.clone()
        { -> print(copy); times }
    }
    let hello = greet(2)
    print(hello() + hello())
    return applyTwice({ x -> x * 2 }, 10)
}

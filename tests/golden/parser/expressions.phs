fun precedence() {
    let a = 1 + 2 * 3 - 4 / 2 % 3
    let b = x & mask == 0 || y | 1 != 2 && !done
    let c = 1 << 2 + 3
    let d = a ?? b ?? c
    let e = -x * ~y
    let f = 0..10
    let g = 0..<n + 1
    let h = value as Int64 + 1
    let i = shape is Circle
    let j = maybe as? Dog
    let k = a &+ b &* c &- d
}

fun generics() {
    let list = List<Int>()
    let map = Map<String, List<Int>>.empty()
    let nested = Box<Box<Box<Int>>>(1)
    let cmp = a < b
    let both = a < b && c > d
    let ok = x as Int < limit
}

fun postfix() {
    let a = obj.field.method(1, two: 2)[3]!
    let b = maybe?.name?.count ?? 0
    let c = try? parse("1")
    let d = await fetch()
    let e = [1, 2, 3,]
    let f = ()
    let g = (a + b) * c
    let chained = builder
        .add(1)
        .add(2)
        ?.build()
}

fun strings() {
    let plain = "hello\n"
    let interp = "x = \(x), y = \(y + 1)!"
    let nested = "outer \("inner \(deep)") done"
    let ch = '\u{1F600}'
}

fun multiline() {
    let total = first +
        second +
        third
    let call = compute(
        1,
        2,
    )
}

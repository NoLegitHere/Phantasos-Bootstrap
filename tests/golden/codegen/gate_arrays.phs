// Arrays stage0 cannot compile yet: growing or shrinking them, `for` loops,
// comparisons, arrays of Unit and structs that hold themselves through an
// array.

struct Tree(let kids: [Tree])

fun main() {
    var a = [1, 2]
    a.append(3)
    let last = a.removeLast()
    for x in a { print(x) }
    let same: Bool = a == [1, 2]
    let o: [Int]? = none
    let missing: Bool = o != none
    let units: [Unit] = []
}

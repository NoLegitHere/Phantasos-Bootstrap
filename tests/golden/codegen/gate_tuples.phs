// Tuples outside the subset: comparisons, optional tuples, Unit or rejected
// elements, and structs that contain themselves through a tuple element.

struct Looped(inner: ([Looped], Int))

fun real(t: (Float64, Int)): Int = t.1

fun unit(t: ((), Int)): Int = t.1

fun maybe(t: (Int, Int)?): Int = 0

fun main(): Int {
    let t = (1, 2)
    if t == (1, 2) { return 0 }
    let (x, y) = t
    return t.0 + x + y
}

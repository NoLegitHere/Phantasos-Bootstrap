// Enum cases (3.34): `Tok.plus`, `Tok.num(1)` and, where the context
// expects an enum, `.plus` and `.num(1)`.
enum Tok {
    num(Int8)
    pair(a: Int, b: Bool)
    plus
}

enum Dir {
    up
    down

    fun flip(): Dir {
        if self == .up { return .down }
        return up
    }
}

fun pick(flag: Bool): Tok {
    if flag { return .plus }
    return .num(7)
}

fun valid() {
    let a = Tok.plus
    let b: Tok = .pair(b: true, a: 1)
    let c: Tok? = .num(-1)
    let list: [Tok] = [.plus, .num(2), Tok.pair(1, b: false)]
    let d = Dir.up.flip()
    let same: Bool = d == .down
}

fun errors() {
    let wrongType: Int = Tok.plus
    let payloadType = Tok.num(true)
    let arity = Tok.num(1, 2)
    let unlabeled = Tok.num(value: 1)
    let range = Tok.num(300)
    let unknown: Tok = .nope
    let bare = Tok.num
    let called = Tok.plus()
    let implicitBare: Tok = .num
    let implicitCalled: Tok = .plus(1)
    let notEnum: Int = .plus
    let mixed = Dir.up == Tok.plus
}

// Payload bindings borrow from the matched value (3.35): they cannot move
// out or be changed, and the arm cannot change or move the place they
// borrow from. `.clone()` gives an owned copy.
enum Msg {
    text(String)
    quit
}

fun take(s: own String) {}

fun borrows(m: Msg): String {
    match m {
        .text(s) -> take(s)
        .quit -> {}
    }
    let copy: String = match m {
        .text(s) -> s.clone()
        .quit -> "quit"
    }
    let kept: String = match m {
        .text(s) -> s
        .quit -> "quit"
    }
    let later: fun() -> String = match m {
        .text(s) -> ({ -> s })
        .quit -> ({ -> "quit" })
    }
    return copy
}

fun places() {
    var m: Msg = .text("a")
    match m {
        .text(s) -> { m = .quit; print(s) }
        .quit -> { m = .text("b") }
    }
    match m {
        .text(_) -> { m = .quit }
        .quit -> {}
    }
}

// Moving the matched place into a closure changes it too.
fun captures(m: own Msg) {
    match m {
        .text(s) -> {
            let later = { -> match m { _ -> 0 } }
            print(s)
        }
        .quit -> {}
    }
}

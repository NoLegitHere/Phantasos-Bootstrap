// Function values the gate accepts, and those it does not yet.

fun one(): Int = 1
fun twice(x: Int): Int = x * 2
fun stop(): Never {
    loop {}
}

fun accepted(f: fun(Int) -> Int): fun() -> Never {
    let g: fun() -> Int = one
    let pair = (twice, g())
    return if pair.0(f(1)) > 0 { stop } else { stop }
}

struct Holder(f: fun(Holder) -> Int)

fun optional(f: fun(Int) -> Unit?) {}

fun compared(): Bool = one == one

fun unit_parameter(f: fun(()) -> Int) {}

fun main(): Int = 0

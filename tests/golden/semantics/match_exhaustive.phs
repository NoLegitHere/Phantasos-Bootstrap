// A match covers every value of its scrutinee (3.36). A missing case is
// named, with nested patterns counted; Bool and optionals list their values,
// while integers and strings need a '_' arm. Arms the earlier arms cover are
// warned about, and guarded arms cover nothing.
enum Inner {
    num(Int)
    pair(Int, Bool)
    plus
}

enum Tok {
    num(Int)
    pair(a: Int, b: Bool)
    plus
    wrap(Inner)
}

enum Empty {}

enum Opt<T> {
    some(T)
    nothing
}

fun covered(t: Tok, flag: Bool?, e: Empty, o: Opt<Int>): Int {
    let a = match t {
        .num(n) -> n
        .pair(a, true) | .pair(a, false) -> a
        .plus -> 0
        .wrap(.plus) -> 1
        .wrap(_) -> 2
    }
    let b = match flag {
        none -> 0
        true -> 1
        false -> 2
    }
    let c: Int = match e {}
    // Generic enums are not checked yet.
    let d = match o { .some(n) -> n }
    return a + b + c + d
}

fun missingCase(t: Tok): Int {
    return match t {
        .num(n) -> n
        .pair(a, _) -> a
    }
}

fun missingNested(t: Tok): Int {
    return match t {
        .wrap(.num(n)) -> n
        .wrap(.plus) | .plus -> 0
        .num(_) | .pair(_, _) -> 0
    }
}

fun missingPayload(t: Tok): Int {
    return match t {
        .pair(a, true) -> a
        _ if a() -> 0
        .num(_) | .plus | .wrap(_) -> 1
    }
}

fun a(): Bool = true

fun missingBool(x: Bool): Int {
    return match x { true -> 1 }
}

fun missingInt(x: Int): Int {
    return match x { 0 -> 1, -1 -> 2 }
}

fun missingString(s: String) {
    match s {
        "a" -> {}
    }
}

fun missingSome(x: Int?): Int {
    return match x { none -> 0 }
}

fun unreachable(t: Tok, x: Int): Int {
    let first = match x {
        _ -> 1
        0 -> 2
    }
    let second = match t {
        .num(n) if n > 0 -> n
        .num(_) -> 0
        .pair(_, _) | .plus | .wrap(_) -> 1
        .plus -> 3
    }
    let third = match x {
        1 -> 1
        1 -> 2
        _ -> 3
    }
    return first + second + third
}

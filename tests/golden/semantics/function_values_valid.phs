// Named top-level functions are values of function type. An overload set
// takes the overload whose type is the expected one.
fun inc(x: Int): Int = x + 1
fun neg(x: Int8): Int8 = -x
fun neg(x: Int): Int = -x
fun twice(f: fun(Int) -> Int, x: Int): Int = f(f(x))

fun main(): Int {
    let step = inc
    let flip: fun(Int8) -> Int8 = neg
    let table: (fun(Int) -> Int, fun(Int) -> Int) = (inc, neg)
    return twice(step, Int(flip(2))) + table.1(twice(neg, 1))
}
